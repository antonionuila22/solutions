---
export const prerender = true;
/**
 * Project Quoter — the page the "Pricing" nav item points to.
 * Redesigned to the Premium Minimal Tech pattern (structure reference:
 * dedicated-development-team.astro sections, careers.astro hero grammar).
 *
 * Title / meta description / keywords / H1 are preserved EXACTLY from the
 * previous version — the page may have traffic.
 *
 * The <Quoter client:only="react" /> island owns all quoting logic and is
 * mounted exactly as before; everything around it is presentation only.
 */
import Layout from "../layouts/Layout.astro";
import Quoter from "../components/Quoter";
import Icon from "../components/icons/Icon.astro";
import HeroColorPanels from "../components/ui/HeroColorPanels.astro";
import BorderBeam from "../components/ui/BorderBeam.astro";
import ShinyButton from "../components/ui/ShinyButton.astro";

const title = "Project Quoter | Codebrand - Get Your Custom Quote";
const description = "Get an instant estimate for your digital project. Choose from one-time services or monthly plans. Web development, branding, SEO, video, photography, and more.";
const keywords = "project quote, web development pricing, branding cost, digital services pricing, monthly development plans, codebrand quoter";

// WhatsApp URL format is fixed site-wide: always the api.whatsapp.com/send/
// form, never the shortened link form.
const waText =
  "Hi Codebrand, I used the project quoter and I'd like to talk about my estimate.";
const whatsappUrl = `https://api.whatsapp.com/send/?phone=50487380714&text=${encodeURIComponent(waText)}&type=phone_number&app_absent=0`;

// Same terms as the previous version of this page — wording unchanged.
const terms = [
  {
    title: "Payment Structure",
    desc: "50% upfront, 30% midway, 10% on delivery, 10% held 15 days as guarantee.",
  },
  {
    title: "Monthly Plans",
    desc: "6-month initial commitment. Cancellation requires 2 months written notice.",
  },
  {
    title: "30-Day Warranty",
    desc: "Limited warranty for bugs and errors specified in the project scope.",
  },
];
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
>
  <!-- Hero — HeroColorPanels as the animated backdrop -->
  <HeroColorPanels panels={6} accentIndex={5}>
    <!-- Legibility scrim now ships inside HeroColorPanels (scrim prop, on by default). -->
    <div class="relative mx-auto max-w-6xl px-4 pt-32 pb-16 sm:px-6 sm:pt-40 sm:pb-20 lg:px-8 lg:pb-24">
      <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-400">
        Pricing
      </p>

      <h1 class="text-hero mt-6 max-w-3xl text-white">
        Get Your Custom Quote
      </h1>

      <p class="text-lead mt-8 max-w-2xl text-slate-300">
        Select the services you need and get an instant estimate. Choose
        between one-time projects or monthly development plans.
      </p>

      <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
        <li class="flex items-center gap-2.5 text-sm font-medium text-slate-300">
          <Icon name="check" class="h-4 w-4 flex-shrink-0 text-[#f48200]" />
          Transparent Pricing
        </li>
        <li class="flex items-center gap-2.5 text-sm font-medium text-slate-300">
          <Icon name="check" class="h-4 w-4 flex-shrink-0 text-[#f48200]" />
          No Commitment
        </li>
      </ul>
    </div>
  </HeroColorPanels>

  <!-- Quoter island — mounted exactly as before; the logic lives in React.
       The wrapper reserves ~92% of the island's measured height (1,976px at
       375w / 1,505px at 1280w) so client:only hydration doesn't shove the
       sections below it — that pop-in measured CLS 0.22. -->
  <section class="bg-white px-4 py-16 sm:px-6 sm:py-20">
    <div class="min-h-[1800px] lg:min-h-[1400px]">
      <Quoter client:only="react" />
    </div>
  </section>

  <!-- The fine print — editorial rows, same terms as before -->
  <section class="bg-slate-50 py-20 sm:py-28">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">
        The fine print
      </p>
      <h2 class="text-display-2 mt-5 max-w-3xl text-slate-900" data-anim="heading">
        The terms behind every estimate
      </h2>
      <p class="mt-6 max-w-2xl leading-relaxed text-slate-600">
        No surprises after the number. These are the conditions every quote
        from this page is built on.
      </p>

      <div class="mt-14 border-t border-slate-200">
        {terms.map((item, i) => (
          <article class="group grid gap-3 border-b border-slate-200 py-8 sm:grid-cols-[4.5rem_1fr] sm:gap-10 sm:py-10">
            <span class="text-sm font-semibold tabular-nums tracking-[0.18em] text-slate-500 sm:pt-1.5">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="text-xl font-semibold text-slate-900 transition-transform duration-300 ease-out-quart group-hover:translate-x-1 sm:text-2xl">
                {item.title}
              </h3>
              <p class="mt-3 max-w-2xl leading-relaxed text-slate-600">{item.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA — one highlighted card, BorderBeam as the single microdetail -->
  <section class="bg-slate-950 py-20 sm:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl border border-white/10 bg-slate-900 px-6 py-14 text-center sm:px-14">
        <BorderBeam duration={8} />

        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-400">
          Next step
        </p>
        <h2 class="text-display-2 mt-5 text-white" data-anim="heading">
          Turn your estimate into a proposal
        </h2>
        <p class="mx-auto mt-6 max-w-xl leading-relaxed text-slate-400">
          The quoter gives you a realistic starting point. Send it our way and
          we'll come back with a scoped proposal — what's included, what it
          costs, and what happens first.
        </p>

        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <ShinyButton href="/contact">Get a Custom Proposal</ShinyButton>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ui-shine inline-flex items-center justify-center gap-2 rounded-full border border-white/20 px-7 py-3 font-semibold text-white transition-colors duration-300 hover:border-white/50"
          >
            <Icon name="message-circle" class="h-5 w-5" />
            Chat on WhatsApp
          </a>
        </div>

        <p class="mt-8 text-sm text-slate-400">
          Or write to{" "}
          <a
            href="mailto:info@codebrand.es"
            class="font-medium text-slate-300 underline underline-offset-4 transition-colors duration-300 hover:text-[#f48200]"
          >info@codebrand.es</a>
        </p>
      </div>
    </div>
  </section>
</Layout>
