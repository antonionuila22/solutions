---
export const prerender = true;
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PageHero from "../../components/PageHero.astro";
import { createBreadcrumbSchema } from "../../utils/schema";
import { sanitizeHtml } from "../../lib/sanitize-html";
import { isRegionHub } from "../../lib/seo/geo-tiers";

export async function getStaticPaths() {
  const regions = await getCollection("regions", ({ data }) => !data.draft);
  const locations = await getCollection("locations", ({ data }) => !data.draft);
  const countries = await getCollection("countryareas", ({ data }) => !data.draft);

  return regions.map((region) => {
    // Get cities in this region
    const regionCities = locations.filter(loc => loc.data.region === region.id);
    // Get country info
    const country = countries.find(c => c.id === region.data.country);

    return {
      params: { id: region.id },
      props: { region, cities: regionCities, country },
    };
  });
}

const { region, cities, country } = Astro.props;
const { data } = region;
const {
  title,
  description,
  name,
  code,
  img,
  imageAlt,
  population,
  capital,
  timezone,
  keywords,
  longDescription,
  industries,
  marketHighlights,
  faqs,
  majorCities,
  regionalStats
} = data;

// ── Language: every region outside the US is written in Spanish, so the page
//    chrome must be Spanish too. ────────────────────────────────────────────
const isSpanish = data.country !== "usa";
// Honest time-zone note per country (Honduras is UTC-6 all year).
const tzNote = data.country === "spain"
  ? `Trabajamos desde Honduras con una franja de coincidencia cada tarde en ${name}, suficiente para reuniones, demos y soporte dentro de su jornada.`
  : data.country === "chile"
    ? `Desde Honduras hay dos o tres horas de diferencia con ${name} según la época del año, así que gran parte de su jornada coincide con la nuestra.`
    : `Trabajamos desde Honduras en horario de Centroamérica, cercano al de ${name}, para colaborar en tiempo real.`;
const waText = encodeURIComponent(`Hola Codebrand, tengo un proyecto web en ${name} y quiero una propuesta.`);
const whatsappUrl = `https://api.whatsapp.com/send/?phone=50487380714&text=${waText}&type=phone_number&app_absent=0`;
const t = isSpanish
  ? {
      eyebrow: (n: number) => `${code} · ${n} ${n === 1 ? "ciudad atendida" : "ciudades atendidas"}`,
      heroTitle: `Desarrollo Web en <span class="text-orange-400">${name}</span>`,
      statReviews: "50 reseñas en Google", statFive: "Reseñas de 5 estrellas", statYears: "Años de experiencia del equipo", statCustom: "Hecho a la medida",
      ctaPrimary: { text: "Solicitar propuesta", href: whatsappUrl }, ctaSecondary: { text: "Ver nuestro trabajo", href: "/projects/" },
      population: "Población", capital: "Capital", timezone: "Zona horaria",
      crumbHome: "Inicio", crumbAreas: "Áreas de servicio",
      industriesTitle: `Industrias que atendemos en ${name}`, industriesSub: `Desarrollo web especializado para los sectores económicos clave de ${name}.`,
      marketTitle: `Aspectos clave del mercado de ${name}`, statsTitle: "Datos regionales", gdp: "PIB regional", techCompanies: "Empresas tecnológicas", growth: "Crecimiento empresarial",
      citiesTitle: `Ciudades que atendemos en ${name}`, citiesSub: "Seleccione su ciudad para ver servicios de desarrollo web e información local.",
      featured: "Destacada", populationShort: "Población", viewServices: "Ver servicios",
      whyTitle: `Por qué las empresas de ${name} eligen Codebrand`, whySub: "Desarrollo nearshore con todas las ventajas de un equipo local.",
      why1Title: "Precio cerrado según su presupuesto", why1: `Usted define el presupuesto y nosotros proponemos el alcance que cabe, con un precio fijo por escrito.`,
      why2Title: "Zona horaria compatible", why2: tzNote,
      why3Title: "Equipo en español", why3: "Comunicación directa en español con quienes diseñan y programan su proyecto.",
      faqTitle: "Preguntas frecuentes", faqSub: `Preguntas comunes sobre desarrollo web en ${name}.`,
      ctaTitle: `¿Listo para iniciar su proyecto en ${name}?`, ctaSub: "Cuéntenos qué necesita y el presupuesto que tiene; le respondemos con una propuesta de precio cerrado. Sin compromiso.",
      ctaButton: "Solicitar propuesta", ctaButtonHref: whatsappUrl, ctaWork: "Ver nuestro trabajo",
      listName: `Ciudades con desarrollo web en ${name}`, listDesc: `Ciudades atendidas por Codebrand en ${name}`, listItem: (c: string) => `Desarrollo Web ${c}`,
      crumbSchemaHome: "Inicio", crumbSchemaAreas: "Ubicaciones",
    }
  : {
      eyebrow: (n: number) => `${code} · ${n} ${n === 1 ? "City" : "Cities"} Served`,
      heroTitle: `Web Development in <span class="text-orange-400">${name}</span>`,
      statReviews: "50 Google reviews", statFive: "Five-Star Reviews", statYears: "Years Team Experience", statCustom: "Custom-Built",
      ctaPrimary: { text: "Request a Proposal", href: "/quoter/" }, ctaSecondary: { text: "View Our Work", href: "/projects/" },
      population: "Population", capital: "Capital", timezone: "Timezone",
      crumbHome: "Home", crumbAreas: "Service Areas",
      industriesTitle: `Industries We Serve in ${name}`, industriesSub: `Specialized web development for ${name}'s key economic sectors.`,
      marketTitle: `${name} Market Highlights`, statsTitle: "Regional Statistics", gdp: "State GDP", techCompanies: "Tech Companies", growth: "Business Growth",
      citiesTitle: `Cities We Serve in ${name}`, citiesSub: "Select your city for localized web development services and information.",
      featured: "Featured", populationShort: "Population", viewServices: "View Services",
      whyTitle: `Why ${name} Businesses Choose Codebrand`, whySub: "Nearshore development with all the benefits of a local team.",
      why1Title: "Fixed Price From Your Budget", why1: `You set the budget and we propose the scope that fits it, with a fixed price in writing.`,
      why2Title: "Timezone Compatible", why2: `Honduras CST aligns with ${name}'s ${timezone} timezone for real-time collaboration.`,
      why3Title: "Bilingual Team", why3: "Fluent English communication with no language barriers.",
      faqTitle: "Frequently Asked Questions", faqSub: `Common questions about web development services in ${name}.`,
      ctaTitle: `Ready to Start Your ${name} Project?`, ctaSub: "Tell us what you need and the budget you have. You get a fixed-price proposal within 24 business hours. No commitment required.",
      ctaButton: "Request a Proposal", ctaButtonHref: "/quoter/", ctaWork: "View Our Work",
      listName: `Web Development Cities in ${name}`, listDesc: `Cities served by Codebrand in ${name}`, listItem: (c: string) => `Web Development ${c}, ${code}`,
      crumbSchemaHome: "Home", crumbSchemaAreas: "Locations",
    };

// Sort cities by featured first, then by population/name
const sortedCities = cities.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return a.data.city.localeCompare(b.data.city);
});

// SEO, keep title ≤ 70 chars and description ≤ 160 chars
const baseUrl = "https://www.codebrand.us";
const rawTitle = title;
const seoTitle = rawTitle.length > 70 ? (isSpanish ? `Desarrollo Web en ${name} | Codebrand` : `Web Development in ${name} | Codebrand`) : rawTitle;
const seoDescription = description.length > 160
  ? description.slice(0, 157).replace(/\s+\S*$/, "").trimEnd() + "…"
  : description;
const seoKeywords = (isSpanish ? [
  `desarrollo web ${name}`,
  `agencia de desarrollo web ${name}`,
  `diseño web ${name}`,
  ...(keywords || []),
  ...cities.map(c => `desarrollo web ${c.data.city}`)
] : [
  `web development ${name}`,
  `${name} web development company`,
  `web developers ${name}`,
  ...(keywords || []),
  ...cities.map(c => `web development ${c.data.city}`)
]).join(", ");

// Breadcrumb schema
const breadcrumbSchema = createBreadcrumbSchema([
  { name: t.crumbSchemaHome, url: baseUrl },
  { name: t.crumbSchemaAreas, url: `${baseUrl}/countryareas/` },
  { name: country?.data.name || "Country", url: `${baseUrl}/countryareas/${region.data.country}/` },
  { name: name, url: `${baseUrl}/regions/${region.id}/` },
]);

// ItemList schema for cities
const citiesListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": t.listName,
  "description": t.listDesc,
  "numberOfItems": cities.length,
  "itemListElement": sortedCities.map((city, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": t.listItem(city.data.city),
    "url": `${baseUrl}/locations/${city.id}/`,
  })),
};

// FAQ Schema for SEO
const faqSchema = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  image={img || "/photos/webservice.webp"}
  noindex={!isRegionHub(region.id)}
  lang={isSpanish ? "es" : "en-US"}
  breadcrumbSchemaOverride={breadcrumbSchema}
>
  <!-- Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(citiesListSchema)} />
  {faqSchema && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  )}

  <!-- Hero Section -->
  <PageHero
    eyebrow={t.eyebrow(cities.length)}
    title={t.heroTitle}
    subtitle={description}
    stats={[
      { value: "5.0", label: t.statReviews, counterTo: 5, decimals: 1, color: "orange" },
      { value: "50", label: t.statFive, counterTo: 50, color: "cyan" },
      { value: "8+", label: t.statYears, counterTo: 8, suffix: "+", color: "cyan" },
      { value: "100%", label: t.statCustom, color: "orange" },
    ]}
    ctaPrimary={t.ctaPrimary}
    ctaSecondary={t.ctaSecondary}
  >
    {(population || capital || timezone) && (
      <div class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-400">
        {population && (
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
            {t.population}: {population}
          </span>
        )}
        {capital && (
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            {t.capital}: {capital}
          </span>
        )}
        {timezone && (
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            {t.timezone}: {timezone}
          </span>
        )}
      </div>
    )}
  </PageHero>

  <Breadcrumbs
    items={[
      { name: t.crumbHome, href: "/" },
      { name: t.crumbAreas, href: "/countryareas/" },
      { name: country?.data.name || "Country", href: `/countryareas/${region.data.country}/` },
      { name: name, href: "" }
    ]}
    variant="transparent"
    class="bg-slate-50 border-y border-slate-100"
  />

  <!-- Extended Description Section -->
  {longDescription && (
    <section class="py-12 lg:py-16 bg-white font-poppins">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-lg max-w-none text-slate-700 leading-relaxed" data-anim="fade" set:html={sanitizeHtml(longDescription || '')} />
      </div>
    </section>
  )}

  <!-- Industries Section -->
  {industries && industries.length > 0 && (
    <section class="py-12 lg:py-16 bg-slate-50 font-poppins">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <h2 class="text-display-2 font-bold text-cyan-900 mb-4" data-anim="heading">
            {t.industriesTitle}
          </h2>
          <p class="text-xl text-slate-600 max-w-2xl mx-auto" data-anim="fade" data-delay="0.1">
            {t.industriesSub}
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-anim="fade">
          {industries.map((industry) => (
            <div class="bg-white p-6 rounded-xl shadow-md border border-slate-100">
              <h3 class="text-lg font-bold text-cyan-900 mb-2">{industry.name}</h3>
              {industry.description && (
                <p class="text-slate-600 text-sm">{industry.description}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Market Highlights & Stats Section -->
  {(marketHighlights && marketHighlights.length > 0) || regionalStats ? (
    <section class="py-12 lg:py-16 bg-white font-poppins">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          {marketHighlights && marketHighlights.length > 0 && (
            <div>
              <h2 class="text-2xl font-bold text-cyan-900 mb-6" data-anim="heading">
                {t.marketTitle}
              </h2>
              <ul class="space-y-3" data-anim="fade" data-delay="0.1">
                {marketHighlights.map((highlight) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-orange-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="text-slate-700">{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {regionalStats && (
            <div>
              <h2 class="text-2xl font-bold text-cyan-900 mb-6" data-anim="heading">
                {t.statsTitle}
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4" data-anim="fade" data-delay="0.1">
                {regionalStats.gdp && (
                  <div class="bg-cyan-50 p-4 rounded-xl text-center">
                    <div class="text-2xl font-bold text-cyan-900">{regionalStats.gdp}</div>
                    <div class="text-sm text-slate-600">{t.gdp}</div>
                  </div>
                )}
                {regionalStats.techCompanies && (
                  <div class="bg-cyan-50 p-4 rounded-xl text-center">
                    <div class="text-2xl font-bold text-cyan-900">{regionalStats.techCompanies}</div>
                    <div class="text-sm text-slate-600">{t.techCompanies}</div>
                  </div>
                )}
                {regionalStats.businessGrowth && (
                  <div class="bg-cyan-50 p-4 rounded-xl text-center">
                    <div class="text-2xl font-bold text-cyan-900">{regionalStats.businessGrowth}</div>
                    <div class="text-sm text-slate-600">{t.growth}</div>
                  </div>
                )}
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  ) : null}

  <!-- Cities Grid -->
  {cities.length > 0 && (
    <section class="py-16 lg:py-24 bg-white font-poppins">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-display-2 font-bold text-cyan-900 mb-4" data-anim="heading">
            {t.citiesTitle}
          </h2>
          <p class="text-xl text-slate-600 max-w-2xl mx-auto" data-anim="fade" data-delay="0.1">
            {t.citiesSub}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-anim="fade">
          {sortedCities.map((city) => (
            <a
              href={`/locations/${city.id}/`}
              class="group bg-white p-6 rounded-2xl shadow-md hover:shadow-xl border border-cyan-100 hover:border-orange-300 transition-all duration-300 transform hover:-translate-y-1"
            >
              <div class="flex items-start justify-between mb-3">
                <div class="w-10 h-10 bg-cyan-900 rounded-lg flex items-center justify-center group-hover:bg-orange-500 transition-all duration-300">
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                {city.data.featured && (
                  <span class="px-2 py-1 bg-orange-100 text-orange-700 text-xs font-semibold rounded-full">
                    {t.featured}
                  </span>
                )}
              </div>

              <h3 class="text-xl font-bold text-cyan-900 mb-2 group-hover:text-orange-600 transition-colors">
                {city.data.city}
              </h3>

              <p class="text-slate-600 text-sm mb-3 line-clamp-2">
                {city.data.description}
              </p>

              {city.data.population && (
                <p class="text-xs text-slate-500 mb-3">
                  {t.populationShort}: {city.data.population}
                </p>
              )}

              <span class="inline-flex items-center gap-2 text-orange-600 font-semibold text-sm group-hover:gap-3 transition-all">
                {t.viewServices}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Why Choose Us -->
  <section class="py-16 lg:py-24 bg-slate-50 font-poppins">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-display-2 font-bold text-cyan-900 mb-4" data-anim="heading">
          {t.whyTitle}
        </h2>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto" data-anim="fade" data-delay="0.1">
          {t.whySub}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-anim="fade">
        <div class="bg-white p-8 rounded-2xl shadow-md">
          <div class="w-12 h-12 bg-orange-500 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-cyan-900 mb-2">{t.why1Title}</h3>
          <p class="text-slate-600">
            {t.why1}
          </p>
        </div>

        <div class="bg-white p-8 rounded-2xl shadow-md">
          <div class="w-12 h-12 bg-orange-500 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-cyan-900 mb-2">{t.why2Title}</h3>
          <p class="text-slate-600">
            {t.why2}
          </p>
        </div>

        <div class="bg-white p-8 rounded-2xl shadow-md">
          <div class="w-12 h-12 bg-orange-500 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-cyan-900 mb-2">{t.why3Title}</h3>
          <p class="text-slate-600">
            {t.why3}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  {faqs && faqs.length > 0 && (
    <section class="py-16 lg:py-24 bg-white font-poppins">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-display-2 font-bold text-cyan-900 mb-4" data-anim="heading">
            {t.faqTitle}
          </h2>
          <p class="text-xl text-slate-600" data-anim="fade" data-delay="0.1">
            {t.faqSub}
          </p>
        </div>
        <div class="space-y-6" data-anim="fade">
          {faqs.map((faq) => (
            <div class="bg-slate-50 rounded-xl p-6">
              <h3 class="text-lg font-bold text-cyan-900 mb-3">{faq.question}</h3>
              <p class="text-slate-700 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-cyan-900 to-cyan-800 font-poppins">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-display-2 font-bold text-white mb-6" data-anim="heading">
        {t.ctaTitle}
      </h2>
      <p class="text-xl text-cyan-100 mb-8" data-anim="fade" data-delay="0.1">
        {t.ctaSub}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center" data-anim="fade" data-delay="0.18">
