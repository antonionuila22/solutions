      "datePublished": "2024-09-20"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "50",
    "bestRating": "5",
    "worstRating": "1"
  }
};

// ── Selected work — real, documented client projects (see src/content/projects) ──
const work = [
  {
    n: "01",
    name: "Laboratory & Tech",
    industry: "B2B · Lab Equipment",
    desc: "Custom WooCommerce platform — full catalog, CRM sync, and B2B quoting.",
    metrics: ["7,900+ products", "Custom CRM plugin", "Full API integration"],
    img: "/photos/projects/Laboratory.avif",
    slug: "laboratory-equipment-platform",
  },
  {
    n: "02",
    name: "Zeed Marketing",
    industry: "Digital Marketing Agency",
    desc: "High-converting Astro + React site for a Meta Ads agency, built for speed.",
    metrics: ["139% traffic growth", "0 → 50 daily visitors", "Results in 30 days"],
    img: "/photos/projects/zeed.avif",
    slug: "zeed-meta-ads-agency",
  },
  {
    n: "03",
    name: "TravelUp",
    industry: "Travel Agency · Honduras",
    desc: "Online booking with WhatsApp integration and SEO that scaled a local agency.",
    metrics: ["10 → 20 daily clients", "Top agency positioning", "Full booking system"],
    img: "/photos/projects/travelup.jpg",
    slug: "landing-travel-agency",
  },
  {
    n: "04",
    name: "ESABEP",
    industry: "Industrial · Well Drilling",
    desc: "Lead-generation site for a Honduran drilling firm with 27 years in the field.",
    metrics: ["+1,100 wells drilled", "27 years of expertise", "Qualified online leads"],
    img: "/photos/projects/esabep-Construccion-Pozos.avif",
    slug: "esabep-construccion-pozos",
  },
  {
    n: "05",
    name: "GMJ Architectural Design",
    industry: "Interior Design · USA",
    desc: "Portfolio and booking site that took a St. Louis studio nationwide.",
    metrics: ["Local → nationwide", "Online booking system", "Portfolio showcase"],
    img: "/photos/projects/GMJ.avif",
    slug: "gmj-interior-design-website",
  },
];

// ── Service pillars — each links to its real hub page ──
const pillars = [
  {
    n: "01",
    icon: "code",
    title: "Web Development",
    desc: "Fast, SEO-ready sites and web apps that pass Core Web Vitals.",
    chips: ["Astro", "React", "Next.js", "TypeScript"],
    href: "/services/web-development",
  },
  {
    n: "02",
    icon: "database",
    title: "Custom Software & CRM",
    desc: "Internal tools, dashboards, and our own production CRM — built around your workflow.",
    chips: ["Node.js", "PostgreSQL", "Prisma", "APIs"],
    href: "/custom-software-development",
  },
  {
    n: "03",
    icon: "shopping-cart",
    title: "E-commerce",
    desc: "Storefronts that load fast and convert — catalog to checkout to fulfillment.",
    chips: ["Shopify", "WooCommerce", "Stripe", "PayPal"],
    href: "/e-commerce",
  },
  {
    n: "04",
    icon: "palette",
    title: "UX/UI Design",
    desc: "Research-led interfaces and design systems that turn visitors into customers.",
    chips: ["Figma", "Design Systems", "Prototyping"],
    href: "/ux-ui-design-agency",
  },
  {
    n: "05",
    icon: "users",
    title: "Nearshore Teams",
    desc: "Senior engineers embedded in your team, aligned to US Central time.",
    chips: ["US Timezone", "Senior Devs", "Weekly Sprints"],
    href: "/nearshore-development",
  },
];

// ── How we work — real durations, real deliverables ──
const steps = [
  {
    n: "01",
    icon: "search",
    title: "Discovery",
    dur: "1 week",
    items: ["Scope & requirements", "Technical roadmap", "Fixed, transparent quote"],
  },
  {
    n: "02",
    icon: "pencil",
    title: "Design",
    dur: "1–2 weeks",
    items: ["Wireframes", "UI & design system", "Clickable prototype"],
  },
  {
    n: "03",
    icon: "code",
    title: "Build",
    dur: "Weekly sprints",
    items: ["Production-grade code", "A demo every week", "Staging you can test"],
  },
  {
    n: "04",
    icon: "rocket",
    title: "Launch & Support",
    dur: "Ongoing",
    items: ["Deploy & monitoring", "Performance tuning", "Iteration & support"],
  },
];

// ── Principles — the manifesto answer, engineering-voiced ──
const principles = [
  { lead: "Code you can read.", sub: "Clean, documented, and handed over. No black boxes, no lock-in." },
  { lead: "Deadlines you can trust.", sub: "Weekly sprint demos — progress every week, not just at the end." },
  { lead: "Prices you can see.", sub: "Hourly rates published up front. No surprise invoices, no vague estimates." },
  { lead: "Results you can measure.", sub: "We ship metrics, not promises — traffic, conversions, load times." },
];

// ── Hourly rates — the same numbers the quoter uses ──
const rates = [
  { role: "Mid-Level", price: "$45", desc: "Solid execution on well-defined work.", icon: "code", featured: false },
  { role: "Senior", price: "$65", desc: "Architecture, hard problems, code review.", icon: "cpu", featured: true },
  { role: "Lead", price: "$95", desc: "Technical direction and team ownership.", icon: "target", featured: false },
];

const whatsappUrl =
  "https://api.whatsapp.com/send/?phone=50487380714&text=" +
  encodeURIComponent("Hi Codebrand! I'd like to start a project.") +
  "&type=phone_number&app_absent=0";
---

<Layout
  title="Nearshore Web & Software Development Agency | Codebrand"
  description="Full-service web development agency. Custom websites, apps, and e-commerce. Bilingual React & Next.js experts with 50 five-star reviews. Free consultation."
  image="/photos/bannercodebrand.webp"
>
  <!-- Reviews Schema for Google rich snippets -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(reviewsSchema)} />

  <!-- ============================================================= -->
  <!-- ACT 1 · HERO — instant, typographic, LCP is the headline text -->
  <!-- ============================================================= -->
  <section class="relative overflow-hidden bg-slate-950 font-poppins">
    <div class="hero-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute -top-40 right-0 w-[38rem] h-[38rem] bg-orange-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 sm:pt-32 lg:pt-40 pb-20 sm:pb-24 lg:pb-28">
      <!-- Trust, woven into a clean line — no chips -->
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-sm text-slate-400 mb-8">
        <span class="inline-flex items-center gap-2">
          <span class="relative flex h-2 w-2">
            <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
          </span>
          San Pedro Sula, Honduras 🇭🇳 · US Central Time
        </span>
        <span class="text-slate-700" aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="star" class="w-4 h-4 text-orange-400" />
          5.0 from 50 Google reviews
        </span>
      </p>

      <!-- Headline: this is the LCP element — no animation -->
      <h1 class="max-w-4xl text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-bold tracking-tight text-white leading-[0.95]">
        Built in Honduras.<br />
        <span class="bg-gradient-to-r from-orange-400 via-orange-500 to-amber-400 bg-clip-text text-transparent">Shipped worldwide.</span>
      </h1>

      <p class="mt-8 max-w-2xl text-lg sm:text-xl text-slate-300 leading-relaxed">
        Senior engineers on your timezone — websites that sell, software that ships.
        Transparent rates from <span class="text-white font-semibold">$45/hr</span>, no agency overhead.
      </p>

      <!-- Dual CTA -->
      <div class="mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
        <a
          href="/contact"
          class="group inline-flex items-center justify-center gap-2.5 pl-6 pr-2.5 py-2.5 rounded-full bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white text-sm sm:text-base font-semibold shadow-lg shadow-orange-500/25 hover:shadow-xl hover:shadow-orange-500/40 transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
        >
          Start your project
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-white/15 transition-transform duration-300 group-hover:translate-x-0.5">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
        <a
          href="#work"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-slate-900/70 border border-slate-700 hover:border-slate-500 hover:-translate-y-0.5 text-slate-200 text-sm sm:text-base font-semibold transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
        >
          See our work
        </a>
      </div>

      <!-- Speed-as-craft, classy one-liner -->
      <p class="mt-7 flex items-center gap-2 text-xs text-slate-500">
        <Icon name="zap" class="w-3.5 h-3.5 text-orange-400" />
        Rendered instantly — no boot screen, no spinner. That is the whole point.
      </p>

      <!-- Proof row — bare editorial stats, animated numbers -->
      <div class="mt-14 sm:mt-16 grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10 border-t border-slate-800 pt-10 max-w-4xl">
        <div>
          <div class="flex items-center gap-2 text-4xl sm:text-5xl font-bold text-white tabular-nums">
            <Icon name="star" class="w-6 h-6 text-orange-400" />
            <span data-counter="5.0" data-counter-decimals="1">0</span>
          </div>
          <p class="mt-2 text-xs uppercase tracking-[0.16em] text-slate-500">Google rating</p>
        </div>
        <div>
          <div class="text-4xl sm:text-5xl font-bold text-white tabular-nums"><span data-counter="50">0</span></div>
          <p class="mt-2 text-xs uppercase tracking-[0.16em] text-slate-500">Verified reviews</p>
        </div>
        <div>
          <div class="text-4xl sm:text-5xl font-bold text-white tabular-nums"><span data-counter="6" data-counter-suffix="+">0</span></div>
          <p class="mt-2 text-xs uppercase tracking-[0.16em] text-slate-500">Countries served</p>
        </div>
        <div>
          <div class="flex items-baseline gap-1 text-4xl sm:text-5xl font-bold text-white tabular-nums">
            <span data-counter="99">0</span><span class="text-lg text-slate-600 font-semibold">/100</span>
          </div>
          <p class="mt-2 text-xs uppercase tracking-[0.16em] text-slate-500">Lighthouse mobile</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- ACT 2 · MARQUEE — tech we build with                          -->
  <!-- ============================================================= -->
  <TechMarquee />

  <!-- ============================================================= -->
  <!-- ACT 3 · SELECTED WORK — curated, named, verifiable            -->
  <!-- ============================================================= -->
  <section id="work" class="relative bg-white font-poppins py-24 sm:py-32 lg:py-40 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14 sm:mb-20">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Selected work</p>
        <h2 data-anim="heading" class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-[1.05]">
          Real projects. <span class="bg-gradient-to-r from-orange-500 to-amber-500 bg-clip-text text-transparent">Real numbers.</span>
        </h2>
        <p class="mt-5 text-lg text-slate-500 leading-relaxed">
          A curated few — each with results you can verify.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {work.map((p) => (
          <a
            href={`/projects/${p.slug}`}
            data-anim="fade"
            data-anim-group="work"
            data-stagger="0.08"
            class="group relative flex flex-col rounded-2xl border border-slate-200 bg-white overflow-hidden hover:border-orange-300 hover:shadow-xl hover:shadow-slate-900/5 transition-all duration-500 hover:-translate-y-1"
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-slate-900">
              <img
                src={p.img}
                alt={`${p.name} — ${p.industry}`}
                loading="lazy"
                width="640"
                height="400"
                class="w-full h-full object-cover opacity-95 group-hover:opacity-100 group-hover:scale-[1.03] transition-all duration-700"
              />
            </div>

            <div class="flex flex-col flex-1 p-6 sm:p-7">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">
                {p.n} · {p.industry}
              </p>
              <h3 class="mt-2 text-xl font-bold text-slate-900 group-hover:text-orange-600 transition-colors">{p.name}</h3>
              <p class="mt-2 text-sm text-slate-500 leading-relaxed flex-1">{p.desc}</p>
              <p class="mt-4 text-xs text-slate-500 tabular-nums leading-relaxed">{p.metrics.join("  ·  ")}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-900 group-hover:text-orange-600 transition-colors">
                View case study
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        ))}

        <!-- 6th cell — honest "view all" tile, not a fabricated case -->
        <a
          href="/projects"
          data-anim="fade"
          data-anim-group="work"
          class="group relative flex flex-col items-start justify-center rounded-2xl border border-slate-800 bg-slate-950 text-white p-8 overflow-hidden hover:border-orange-400/60 transition-all duration-500 hover:-translate-y-1"
        >
          <div class="absolute -top-16 -right-16 w-48 h-48 bg-orange-500/15 rounded-full blur-3xl"></div>
          <span class="relative text-6xl font-bold tracking-tight tabular-nums"><span data-counter="16" data-counter-suffix="+">0</span></span>
          <p class="relative mt-3 text-lg font-semibold">documented projects</p>
          <p class="relative mt-1 text-sm text-slate-400">United States · Honduras · LATAM</p>
          <span class="relative mt-7 inline-flex items-center gap-2 text-sm font-semibold text-orange-400">
            See all work
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-white/10 transition-transform duration-300 group-hover:translate-x-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- SOCIAL PROOF — real Google reviews (schema above)             -->
  <!-- ============================================================= -->
  <section class="bg-slate-950 font-poppins py-24 sm:py-28 lg:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-14 sm:mb-16">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Client reviews</p>
      <h2 data-anim="heading" class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-[1.05]">
        What clients actually <span class="text-orange-400">say</span>
      </h2>
      <p class="mt-5 text-base sm:text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Verified Google reviews across web development, e-commerce, and design.
      </p>
    </div>
    <Testimonial />
  </section>

  <!-- ============================================================= -->
  <!-- WHY CHOOSE US — value proposition + price comparison (shared) -->
  <!-- ============================================================= -->
  <ValueProposition />

  <!-- ============================================================= -->
  <!-- ACT 4 · SERVICES — five pillars, editorial list               -->
  <!-- ============================================================= -->
  <section class="relative bg-slate-50 font-poppins py-24 sm:py-32 lg:py-40 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14 sm:mb-16">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">What we build</p>
        <h2 data-anim="heading" class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-[1.05]">
          Five things, done <span class="bg-gradient-to-r from-orange-500 to-amber-500 bg-clip-text text-transparent">seriously well.</span>
        </h2>
        <p class="mt-5 text-lg text-slate-500 leading-relaxed">
          Not a menu of everything. The stack we ship every week, at senior level.
        </p>
      </div>

      <div class="border-t border-slate-200">
        {pillars.map((s) => (
          <a
            href={s.href}
            data-anim="fade"
            data-anim-group="pillars"
            data-stagger="0.06"
            class="group grid grid-cols-1 sm:grid-cols-12 gap-x-8 gap-y-3 items-baseline border-b border-slate-200 py-8 sm:py-10 transition-colors duration-300 hover:bg-white"
          >
            <div class="sm:col-span-5 flex items-center gap-4">
              <span class="text-sm font-bold text-slate-300 tabular-nums group-hover:text-orange-500 transition-colors">{s.n}</span>
              <span class="flex items-center justify-center w-11 h-11 rounded-xl border border-slate-200 bg-white text-slate-500 group-hover:border-orange-300 group-hover:text-orange-600 transition-colors duration-300 shrink-0">
                <Icon name={s.icon} class="w-5 h-5" />
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-slate-900 group-hover:text-orange-600 transition-colors">{s.title}</h3>
            </div>
            <div class="sm:col-span-5 sm:pl-4">
              <p class="text-slate-600 leading-relaxed">{s.desc}</p>
              <p class="mt-2 text-xs uppercase tracking-[0.12em] text-slate-400">{s.chips.join(" · ")}</p>
            </div>
            <div class="sm:col-span-2 flex sm:justify-end">
              <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-900 group-hover:text-orange-600 transition-colors">
                Explore
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <p class="mt-10 text-slate-500">
        Most projects blend a few of these.
        <a href="/contact" class="font-semibold text-orange-600 hover:text-orange-700 transition-colors">Tell us the goal →</a>
      </p>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- ACT 5 · PROCESS — durations + per-step deliverables           -->
  <!-- ============================================================= -->
  <section class="relative bg-slate-950 font-poppins py-24 sm:py-32 lg:py-40 overflow-hidden">
    <div class="absolute inset-0 hero-grid opacity-40 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14 sm:mb-20">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">How we work</p>
        <h2 data-anim="heading" class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.05]">
          From kickoff to launch, <span class="text-orange-400">on the clock.</span>
        </h2>
        <p class="mt-5 text-lg text-slate-400 leading-relaxed">
          A demo every week means no surprises at the end — only progress you have already seen.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-10">
        {steps.map((st) => (
          <div
            data-anim="fade"
            data-anim-group="process"
            data-stagger="0.1"
            class="border-t border-slate-800 pt-6"
          >
            <div class="flex items-center justify-between mb-5">
              <span class="flex items-center justify-center w-11 h-11 rounded-xl border border-slate-800 text-orange-400">
                <Icon name={st.icon} class="w-5 h-5" />
              </span>
              <span class="text-sm font-bold text-slate-700 tabular-nums">{st.n}</span>
            </div>
            <h3 class="text-lg font-bold text-white">{st.title}</h3>
            <span class="mt-1.5 inline-flex items-center gap-1.5 text-xs font-semibold text-orange-400">
              <Icon name="clock" class="w-3.5 h-3.5" />
              {st.dur}
            </span>
            <ul class="mt-5 space-y-2.5">
              {st.items.map((it) => (
                <li class="flex items-start gap-2 text-sm text-slate-300">
                  <Icon name="check" class="w-4 h-4 text-orange-400 shrink-0 mt-0.5" />
                  {it}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- ACT 6 · PRINCIPLES — typographic manifesto                    -->
  <!-- ============================================================= -->
  <section class="relative bg-white font-poppins py-24 sm:py-32 lg:py-40">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400 mb-12">How we think</p>
      <div>
        {principles.map((pr, i) => (
          <div data-anim="fade" data-anim-group="principles" data-stagger="0.08" class="group flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-10 border-t border-slate-200 py-8 sm:py-12">
            <span class="text-sm font-bold text-slate-300 tabular-nums shrink-0 sm:w-16 group-hover:text-orange-500 transition-colors">0{i + 1}</span>
            <div>
              <h3 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 leading-tight">
                {pr.lead}
              </h3>
              <p class="mt-4 text-base sm:text-lg text-slate-500 max-w-2xl leading-relaxed">{pr.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- ACT 7 · PRICING — hourly rates + interactive TeamQuoter        -->
  <!-- ============================================================= -->
  <section id="pricing" class="relative bg-slate-50 font-poppins py-24 sm:py-32 lg:py-40 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14 sm:mb-16">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Transparent pricing</p>
        <h2 data-anim="heading" class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-[1.05]">
          Rates on the table. <span class="bg-gradient-to-r from-orange-500 to-amber-500 bg-clip-text text-transparent">No sales call needed.</span>
        </h2>
        <p class="mt-5 text-lg text-slate-500 leading-relaxed">
          Hourly, senior-led, no monthly lock-in. Build a team below and see your price instantly.
        </p>
      </div>

      <!-- Rate cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5 mb-12 sm:mb-14">
        {rates.map((r) => (
          <div class={`relative flex flex-col rounded-2xl border p-7 transition-all duration-500 hover:-translate-y-1 ${r.featured ? "border-orange-300 bg-white shadow-xl shadow-orange-500/5 sm:-translate-y-2" : "border-slate-200 bg-white hover:border-slate-300"}`}>
            {r.featured && (
              <span class="mb-4 text-xs font-semibold uppercase tracking-[0.16em] text-orange-500">Most requested</span>
            )}
            <span class={`flex items-center justify-center w-11 h-11 rounded-xl border ${r.featured ? "bg-orange-500 border-orange-500 text-white" : "bg-white border-slate-200 text-slate-500"}`}>
              <Icon name={r.icon} class="w-5 h-5" />
            </span>
            <h3 class="mt-5 text-lg font-bold text-slate-900">{r.role}</h3>
            <div class="mt-1 flex items-baseline gap-1">
              <span class="text-4xl font-bold tracking-tight text-slate-900">{r.price}</span>
              <span class="text-sm font-semibold text-slate-400">/ hour</span>
            </div>
            <p class="mt-3 text-sm text-slate-500 leading-relaxed">{r.desc}</p>
          </div>
        ))}
      </div>

      <!-- Interactive quoter — the killer vs static price cards -->
      <TeamQuoter client:visible />

      <!-- Quoter promo — instant full-scope estimate at /quoter -->
      <div class="mt-14 sm:mt-16 grid gap-8 sm:grid-cols-12 sm:items-center border-t border-slate-200 pt-12 sm:pt-14">
        <div class="sm:col-span-7">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Project quoter</p>
          <h3 class="mt-4 text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 leading-tight">
            Prefer a full breakdown? <span class="text-orange-600">Get an instant project quote.</span>
          </h3>
          <p class="mt-3 text-slate-500 leading-relaxed max-w-xl">
            Price web, branding, SEO, video, and monthly plans in a couple of minutes — no call required.
          </p>
        </div>
        <div class="sm:col-span-5 flex sm:justify-end">
          <a
            href="/quoter"
            class="group inline-flex items-center justify-center gap-2.5 pl-6 pr-2.5 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-sm sm:text-base font-semibold shadow-lg shadow-slate-900/10 hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50"
          >
            Get an instant quote
            <span class="flex items-center justify-center w-8 h-8 rounded-full bg-white/15 transition-transform duration-300 group-hover:translate-x-0.5">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- STRATEGIC PARTNERSHIP — Zeed Agency banner (shared)           -->
  <!-- ============================================================= -->
  <PartnershipBanner />

  <!-- ============================================================= -->
  <!-- ACT 8 · TEAM — real faces, real profiles                      -->
  <!-- ============================================================= -->
  <section class="bg-white font-poppins pt-24 sm:pt-28 lg:pt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">The team</p>
      <h2 data-anim="heading" class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-[1.05]">
        Real people. <span class="bg-gradient-to-r from-orange-500 to-amber-500 bg-clip-text text-transparent">Real profiles.</span>
      </h2>
      <p class="mt-5 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
        No stock photos, no anonymous contractors. The engineers who build your project have names, faces, and profiles you can read.
      </p>
    </div>
    <Ourteam />
  </section>

  <!-- Featured-on credibility strip -->
  <TrustBadges />

  <!-- ============================================================= -->
  <!-- RECOGNITION — DesignRush (shared)                             -->
  <!-- ============================================================= -->
  <DesignRushSection />

  <!-- ============================================================= -->
  <!-- ACT 9 · FAQ + FINAL CTA                                        -->
  <!-- ============================================================= -->
  <Faq />

  <section class="relative bg-slate-950 font-poppins py-24 sm:py-32 lg:py-40 overflow-hidden">
    <div class="hero-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute -top-40 left-1/3 w-[34rem] h-[34rem] bg-orange-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 data-anim="heading" class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.05]">
        Let's build the thing <span class="bg-gradient-to-r from-orange-400 to-amber-400 bg-clip-text text-transparent">that ships.</span>
      </h2>
      <p class="mt-6 text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Tell us the goal. You get a clear plan, an honest quote, and a first response in under two hours — Monday to Friday, US Central time.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3.5">
        <a
          href="/contact"
          class="group inline-flex items-center justify-center gap-2.5 pl-6 pr-2.5 py-2.5 rounded-full bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white text-sm sm:text-base font-semibold shadow-lg shadow-orange-500/25 hover:shadow-xl hover:shadow-orange-500/40 transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
        >
          Start your project
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-white/15 transition-transform duration-300 group-hover:translate-x-0.5">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-slate-900/70 border border-slate-700 hover:border-orange-500/50 hover:-translate-y-0.5 text-slate-200 text-sm sm:text-base font-semibold transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
        >
          <Icon name="message-circle" class="w-4 h-4 text-orange-400" />
          Chat on WhatsApp
        </a>
      </div>

      <p class="mt-8 text-xs text-slate-500">
        Currently onboarding new projects · San Pedro Sula, Honduras 🇭🇳 · Serving the US, LATAM & EU
      </p>
    </div>
  </section>
</Layout>

