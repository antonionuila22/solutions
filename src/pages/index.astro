      "datePublished": "2024-10-20"
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Tepeu Guerrero" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Muy sorprendido con su trabajo, hicieron una página web para mi lavandería por solo $600. Por su calidad y precio los recomiendo al 100.",
