---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Icon from "../components/icons/Icon.astro";
import TeamQuoter from "../components/TeamQuoter";
import Ourteam from "@/components/Ourteam.astro";
import Faq from "../components/Faq.astro";
import TechMarquee from "../components/TechMarquee.astro";
import Testimonial from "../components/Testimonial.astro";
import TrustBadges from "../components/TrustBadges.astro";

// Review Schema for Google rich snippets - real Google reviews
const reviewsSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.codebrand.us/#organization",
  "name": "Codebrand",
  "url": "https://www.codebrand.us",
  "review": [
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Cesar Franco" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "¡ESTA GENTE SI SABE LO QUE YO QUIERO! ¡EXCELENTE TRABAJO! Me hicieron un trabajo súper profesional y creativo para mi diseño en la página web.",
      "datePublished": "2024-11-15"
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Serling Topete" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Contratamos a Codebrand para que nos hiciera nuestra página web desde cero y el resultado ha sido asombroso. No solo diseñan la página, sino que se involucran en todo el proceso.",
      "datePublished": "2024-10-20"
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Tepeu Guerrero" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Muy sorprendido con su trabajo, hicieron una página web para mi lavandería por solo $600. Por su calidad y precio los recomiendo al 100.",
      "datePublished": "2024-09-10"
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Elvin Amador" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Excelente experiencia con Codebrand. Destacan por su profesionalismo, creatividad y atención al detalle. Los recomiendo totalmente.",
      "datePublished": "2024-08-15"
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Luis Rios" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Buen servicio, el equipo brinda excelente atención al cliente. Muy recomendable si necesitas un experto que maneje tu sitio web.",
      "datePublished": "2024-07-22"
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Cindy Serrano" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Gracias, estoy en México y me dieron un excelente servicio.",
      "datePublished": "2024-09-20"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "50",
    "bestRating": "5",
    "worstRating": "1"
  }
};

// ── Selected work — real, documented client projects (see src/content/projects) ──
const work = [
  {
    n: "01",
    name: "Laboratory & Tech",
    industry: "B2B · Lab Equipment",
    desc: "Custom WooCommerce platform built from scratch — full catalog, CRM sync and a B2B quote system.",
    metrics: ["7,900+ products", "Custom CRM plugin", "Full API integration"],
    img: "/photos/projects/Laboratory.avif",
    slug: "laboratory-equipment-platform",
  },
  {
    n: "02",
    name: "Zeed Marketing",
    industry: "Digital Marketing Agency",
    desc: "High-converting Astro + React site for a Meta Ads agency, engineered for speed and lead capture.",
    metrics: ["139% traffic growth", "0 → 50 daily visitors", "Results in 30 days"],
    img: "/photos/projects/zeed.avif",
    slug: "zeed-meta-ads-agency",
  },
  {
    n: "03",
    name: "TravelUp",
    industry: "Travel Agency · Honduras",
    desc: "Complete online booking system with WhatsApp integration and SEO that scaled a local agency.",
    metrics: ["10 → 20 daily clients", "Top agency positioning", "Full booking system"],
    img: null,
    slug: "landing-travel-agency",
  },
  {
    n: "04",
    name: "ESABEP",
    industry: "Industrial · Well Drilling",
    desc: "Corporate lead-generation site for a Honduran drilling company with 27 years of field experience.",
    metrics: ["+1,100 wells drilled", "27 years of expertise", "Qualified online leads"],
    img: "/photos/projects/esabep-Construccion-Pozos.avif",
    slug: "esabep-construccion-pozos",
  },
  {
    n: "05",
    name: "GMJ Architectural Design",
    industry: "Interior Design · USA",
    desc: "Portfolio and booking site that took a St. Louis studio from local-only to nationwide reach.",
    metrics: ["Local → nationwide", "Online booking system", "Portfolio showcase"],
    img: "/photos/projects/GMJ.avif",
    slug: "gmj-interior-design-website",
  },
];

// ── Service pillars — each links to its real hub page ──
const pillars = [
  {
    n: "01",
    icon: "code",
    title: "Web Development",
    desc: "Fast, SEO-ready websites and web apps engineered to pass Core Web Vitals.",
    chips: ["Astro", "React", "Next.js", "TypeScript"],
    href: "/services/web-development",
  },
  {
    n: "02",
    icon: "database",
    title: "Custom Software & CRM",
    desc: "Internal tools, dashboards, and our own production CRM — built around your workflow.",
    chips: ["Node.js", "PostgreSQL", "Prisma", "APIs"],
    href: "/custom-software-development",
  },
  {
    n: "03",
    icon: "shopping-cart",
    title: "E-commerce",
    desc: "Storefronts that load fast and convert — from catalog to checkout to fulfillment.",
    chips: ["Shopify", "WooCommerce", "Stripe", "PayPal"],
    href: "/e-commerce",
  },
  {
    n: "04",
    icon: "palette",
    title: "UX/UI Design",
    desc: "Research-led interfaces and design systems that turn visitors into customers.",
    chips: ["Figma", "Design Systems", "Prototyping"],
    href: "/ux-ui-design-agency",
  },
  {
    n: "05",
    icon: "users",
    title: "Nearshore Teams",
    desc: "Senior engineers embedded in your team and aligned to US Central time.",
    chips: ["US Timezone", "Senior Devs", "Weekly Sprints"],
    href: "/nearshore-development",
  },
];

// ── How we work — real durations, real deliverables ──
const steps = [
  {
    n: "01",
    icon: "search",
    title: "Discovery",
    dur: "1 week",
    items: ["Scope & requirements", "Technical roadmap", "Fixed, transparent quote"],
  },
  {
    n: "02",
    icon: "pencil",
    title: "Design",
    dur: "1–2 weeks",
    items: ["Wireframes", "UI & design system", "Clickable prototype"],
  },
  {
    n: "03",
    icon: "code",
    title: "Build",
    dur: "Weekly sprints",
    items: ["Production-grade code", "A demo every week", "Staging you can test"],
  },
  {
    n: "04",
    icon: "rocket",
    title: "Launch & Support",
    dur: "Ongoing",
    items: ["Deploy & monitoring", "Performance tuning", "Iteration & support"],
  },
];

// ── Principles — the manifesto answer, engineering-voiced ──
const principles = [
  { lead: "Code you can read.", sub: "Clean, documented, and handed over. No black boxes, no lock-in." },
  { lead: "Deadlines you can trust.", sub: "Weekly sprint demos — you see progress every week, not just at the end." },
  { lead: "Prices you can see.", sub: "Hourly rates published up front. No surprise invoices, no vague estimates." },
  { lead: "Results you can measure.", sub: "We ship metrics, not promises — traffic, conversions, load times." },
];

// ── Hourly rates — the same numbers the quoter uses ──
const rates = [
  { role: "Mid-Level", price: "$45", desc: "Solid execution on well-defined work.", icon: "code", featured: false },
  { role: "Senior", price: "$65", desc: "Architecture, hard problems, code review.", icon: "cpu", featured: true },
  { role: "Lead", price: "$95", desc: "Technical direction and team ownership.", icon: "target", featured: false },
];

const whatsappUrl =
  "https://api.whatsapp.com/send/?phone=50487380714&text=" +
  encodeURIComponent("Hi Codebrand! I'd like to start a project.") +
  "&type=phone_number&app_absent=0";
---

<Layout
  title="Nearshore Web & Software Development Agency | Codebrand"
  description="Full-service web development agency. Custom websites, apps, and e-commerce. Bilingual React & Next.js experts with 50 five-star reviews. Free consultation."
  image="/photos/bannercodebrand.webp"
>
  <!-- Reviews Schema for Google rich snippets -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(reviewsSchema)} />

  <!-- ============================================================= -->
  <!-- ACT 1 · HERO — instant, typographic, LCP is the headline text -->
  <!-- ============================================================= -->
  <section class="relative overflow-hidden bg-slate-950 font-poppins">
    <div class="hero-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute -top-40 right-0 w-[38rem] h-[38rem] bg-orange-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="absolute -bottom-52 -left-24 w-[34rem] h-[34rem] bg-cyan-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 sm:pt-32 lg:pt-40 pb-16 sm:pb-20 lg:pb-24">
      <!-- Eyebrow -->
      <div class="flex flex-wrap items-center gap-3 mb-7">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/80 border border-cyan-500/30 text-xs font-medium text-cyan-300 tracking-wide">
          <span class="relative flex h-2 w-2">
            <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
          </span>
          San Pedro Sula, Honduras 🇭🇳 · US Central Time
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-slate-900/80 border border-orange-500/30 text-xs font-medium text-orange-300 tracking-wide">
          <Icon name="star" class="w-3.5 h-3.5 text-orange-400" />
          5.0 · 50 Google reviews
        </span>
      </div>

      <!-- Headline: one gradient span max — this is the LCP element, no animation -->
      <h1 class="max-w-4xl text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-bold tracking-tight text-white leading-[0.95]">
        Built in Honduras.<br />
        <span class="bg-gradient-to-r from-orange-400 via-orange-500 to-amber-400 bg-clip-text text-transparent">Shipped worldwide.</span>
      </h1>

      <p class="mt-7 max-w-2xl text-lg sm:text-xl text-slate-300 leading-relaxed">
        Senior engineers on your timezone, building websites that sell and software that ships.
        Transparent hourly rates from <span class="text-white font-semibold">$45/hr</span> — no bloated agency overhead, no offshore surprises.
      </p>

      <!-- Dual CTA -->
      <div class="mt-9 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
        <a
          href="/contact"
          class="group inline-flex items-center justify-center gap-2.5 pl-6 pr-2.5 py-2.5 rounded-full bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white text-sm sm:text-base font-semibold shadow-lg shadow-orange-500/25 transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]"
        >
          Start your project
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-white/15 transition-transform duration-300 group-hover:translate-x-0.5">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
        <a
          href="#work"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-slate-900/70 border border-slate-700 hover:border-slate-500 text-slate-200 text-sm sm:text-base font-semibold transition-colors duration-300"
        >
          See our work
        </a>
      </div>

      <!-- Speed-as-craft, classy one-liner -->
      <p class="mt-6 flex items-center gap-2 text-xs text-slate-500">
        <Icon name="zap" class="w-3.5 h-3.5 text-cyan-400" />
        Rendered instantly — no boot screen, no spinner. That is the whole point.
      </p>

      <!-- Proof row — 4 stat cards, static numbers (always visible) -->
      <div class="mt-12 sm:mt-14 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 max-w-4xl">
        <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-4 sm:p-5">
          <div class="flex items-center gap-1.5 mb-1">
            <Icon name="star" class="w-5 h-5 text-orange-400" />
            <span class="text-2xl sm:text-3xl font-bold text-white">5.0</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-400">Google rating</p>
        </div>
        <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-4 sm:p-5">
          <span class="text-2xl sm:text-3xl font-bold text-white">50</span>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">Verified reviews</p>
        </div>
        <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-4 sm:p-5">
          <span class="text-2xl sm:text-3xl font-bold text-white">6+</span>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">Countries served</p>
        </div>
        <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-4 sm:p-5">
          <div class="flex items-baseline gap-1">
            <span class="text-2xl sm:text-3xl font-bold text-white">99</span>
            <span class="text-sm text-slate-500 font-semibold">/100</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">Lighthouse (mobile)</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- ACT 2 · MARQUEE — tech we build with                          -->
  <!-- ============================================================= -->
  <TechMarquee />

  <!-- ============================================================= -->
  <!-- ACT 3 · SELECTED WORK — curated, named, verifiable            -->
  <!-- ============================================================= -->
  <section id="work" class="relative bg-white font-poppins py-20 sm:py-24 lg:py-32 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12 sm:mb-16">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-orange-50 border border-orange-200/70 text-[11px] font-semibold uppercase tracking-[0.18em] text-orange-600">
          Selected Work
        </span>
        <h2 data-anim="heading" class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-tight">
          Real projects. <span class="bg-gradient-to-r from-orange-500 to-amber-500 bg-clip-text text-transparent">Real numbers.</span>
        </h2>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed">
          A curated few — each with results you can verify, not a wall of thumbnails.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {work.map((p) => (
          <a
            href={`/projects/${p.slug}`}
            data-anim="fade"
            data-anim-group="work"
            data-stagger="0.08"
            class="group relative flex flex-col rounded-2xl border border-slate-200 bg-slate-50/60 overflow-hidden hover:border-orange-300 hover:shadow-xl hover:shadow-slate-900/5 transition-all duration-500 hover:-translate-y-1"
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-slate-900">
              {p.img ? (
                <img
                  src={p.img}
                  alt={`${p.name} — ${p.industry}`}
                  loading="lazy"
                  width="640"
                  height="400"
                  class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-[1.03] transition-all duration-700"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-900 via-slate-800 to-cyan-900">
                  <span class="text-4xl font-bold tracking-tight text-white/90">{p.name}</span>
                </div>
              )}
              <span class="absolute top-3 left-3 text-xs font-bold text-white/70 bg-black/30 backdrop-blur-sm px-2 py-1 rounded-md tabular-nums">{p.n}</span>
            </div>

            <div class="flex flex-col flex-1 p-5 sm:p-6">
              <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-orange-600">{p.industry}</span>
              <h3 class="mt-1.5 text-xl font-bold text-slate-900 group-hover:text-orange-600 transition-colors">{p.name}</h3>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed flex-1">{p.desc}</p>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {p.metrics.map((m) => (
                  <li class="inline-flex items-center gap-1 rounded-full bg-white border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-700">
                    <Icon name="trending-up" class="w-3 h-3 text-cyan-600" />
                    {m}
                  </li>
                ))}
              </ul>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-900 group-hover:text-orange-600 transition-colors">
                View case study
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        ))}

        <!-- 6th cell — honest "view all" tile, not a fabricated case -->
        <a
          href="/projects"
          data-anim="fade"
          data-anim-group="work"
          class="group relative flex flex-col items-start justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-900 text-white p-7 sm:p-8 overflow-hidden hover:border-orange-400 transition-colors duration-500"
        >
          <div class="absolute -top-16 -right-16 w-48 h-48 bg-orange-500/15 rounded-full blur-3xl"></div>
          <span class="relative text-5xl font-bold tracking-tight">16<span class="text-orange-400">+</span></span>
          <p class="relative mt-2 text-lg font-semibold">documented projects</p>
          <p class="relative mt-1 text-sm text-slate-400">United States · Honduras · LATAM</p>
          <span class="relative mt-6 inline-flex items-center gap-2 text-sm font-semibold text-orange-400">
            See all work
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-white/10 transition-transform duration-300 group-hover:translate-x-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- SOCIAL PROOF — real Google reviews (schema above)             -->
  <!-- ============================================================= -->
  <section class="bg-slate-950 font-poppins py-16 sm:py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-10 sm:mb-12">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-900 border border-cyan-500/30 text-[11px] font-semibold uppercase tracking-[0.18em] text-cyan-300">
        5.0 from 50 reviews
      </span>
      <h2 data-anim="heading" class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">
        What clients actually <span class="text-orange-400">say</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-400 max-w-2xl mx-auto">
        Verified Google reviews from real clients across web development, e-commerce, and design.
      </p>
    </div>
    <Testimonial />
  </section>

  <!-- ============================================================= -->
  <!-- ACT 4 · SERVICES — 5 numbered pillars with tech chips         -->
  <!-- ============================================================= -->
  <section class="relative bg-slate-50 font-poppins py-20 sm:py-24 lg:py-32 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12 sm:mb-16">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-600">
          What we build
        </span>
        <h2 data-anim="heading" class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-tight">
          Five things, done <span class="bg-gradient-to-r from-orange-500 to-amber-500 bg-clip-text text-transparent">seriously well.</span>
        </h2>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed">
          Not a menu of everything. The stack we ship every week, at senior level.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {pillars.map((s) => (
          <a
            href={s.href}
            data-anim="fade"
            data-anim-group="pillars"
            data-stagger="0.08"
            class="group relative flex flex-col rounded-2xl border border-slate-200 bg-white p-6 sm:p-7 hover:border-orange-300 hover:shadow-xl hover:shadow-slate-900/5 transition-all duration-500 hover:-translate-y-1"
          >
            <div class="flex items-center justify-between">
              <span class="flex items-center justify-center w-12 h-12 rounded-xl bg-orange-50 border border-orange-100 text-orange-600 group-hover:bg-orange-500 group-hover:text-white transition-colors duration-300">
                <Icon name={s.icon} class="w-6 h-6" />
              </span>
              <span class="text-sm font-bold text-slate-300 tabular-nums group-hover:text-orange-400 transition-colors">{s.n}</span>
            </div>
            <h3 class="mt-5 text-xl font-bold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed flex-1">{s.desc}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {s.chips.map((c) => (
                <li class="rounded-md bg-slate-100 px-2 py-1 text-[11px] font-medium text-slate-600">{c}</li>
              ))}
            </ul>
            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-900 group-hover:text-orange-600 transition-colors">
              Explore service
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        ))}

        <div class="relative flex flex-col justify-center rounded-2xl border border-slate-900 bg-slate-900 text-white p-6 sm:p-7 overflow-hidden">
          <div class="absolute -bottom-16 -left-10 w-44 h-44 bg-cyan-500/15 rounded-full blur-3xl"></div>
          <h3 class="relative text-xl font-bold">Need a mix?</h3>
          <p class="relative mt-2 text-sm text-slate-300 leading-relaxed">
            Most projects blend a few of these. Tell us the goal — we scope the right team.
          </p>
          <a
            href="/contact"
            class="relative mt-5 inline-flex items-center gap-2 text-sm font-semibold text-orange-400"
          >
            Talk to an engineer
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- ACT 5 · PROCESS — durations + per-step deliverables           -->
  <!-- ============================================================= -->
  <section class="relative bg-slate-950 font-poppins py-20 sm:py-24 lg:py-32 overflow-hidden">
    <div class="absolute inset-0 hero-grid opacity-40 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12 sm:mb-16">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-900 border border-cyan-500/30 text-[11px] font-semibold uppercase tracking-[0.18em] text-cyan-300">
          How we work
        </span>
        <h2 data-anim="heading" class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight">
          From kickoff to launch, <span class="text-orange-400">on the clock.</span>
        </h2>
        <p class="mt-4 text-lg text-slate-400 leading-relaxed">
          A demo every week means no surprises at the end — only progress you have already seen.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
        {steps.map((st) => (
          <div
            data-anim="fade"
            data-anim-group="process"
            data-stagger="0.1"
            class="relative flex flex-col rounded-2xl border border-slate-800 bg-slate-900/60 p-6 hover:border-cyan-500/40 transition-colors duration-500"
          >
            <div class="flex items-center justify-between">
              <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400">
                <Icon name={st.icon} class="w-5 h-5" />
              </span>
              <span class="text-sm font-bold text-slate-700 tabular-nums">{st.n}</span>
            </div>
            <h3 class="mt-5 text-lg font-bold text-white">{st.title}</h3>
            <span class="mt-1 inline-flex items-center gap-1.5 text-xs font-semibold text-orange-400">
              <Icon name="clock" class="w-3.5 h-3.5" />
              {st.dur}
            </span>
            <ul class="mt-4 space-y-2">
              {st.items.map((it) => (
                <li class="flex items-start gap-2 text-sm text-slate-300">
                  <Icon name="check" class="w-4 h-4 text-cyan-400 shrink-0 mt-0.5" />
                  {it}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- ACT 6 · PRINCIPLES — typographic manifesto                    -->
  <!-- ============================================================= -->
  <section class="relative bg-white font-poppins py-20 sm:py-24 lg:py-32">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-orange-50 border border-orange-200/70 text-[11px] font-semibold uppercase tracking-[0.18em] text-orange-600 mb-10">
        How we think
      </span>
      <div class="space-y-8 sm:space-y-10">
        {principles.map((pr, i) => (
          <div data-anim="fade" data-anim-group="principles" data-stagger="0.08" class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-8 border-b border-slate-100 pb-8 sm:pb-10">
            <span class="text-sm font-bold text-slate-300 tabular-nums shrink-0 sm:w-16">0{i + 1}</span>
            <div>
              <h3 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 leading-tight">
                {pr.lead}
              </h3>
              <p class="mt-3 text-base sm:text-lg text-slate-500 max-w-2xl leading-relaxed">{pr.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- ACT 7 · PRICING — hourly rates + interactive TeamQuoter        -->
  <!-- ============================================================= -->
  <section id="pricing" class="relative bg-slate-50 font-poppins py-20 sm:py-24 lg:py-32 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12 sm:mb-14">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-600">
          Transparent pricing
        </span>
        <h2 data-anim="heading" class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-tight">
          Rates on the table. <span class="bg-gradient-to-r from-orange-500 to-amber-500 bg-clip-text text-transparent">No sales call needed.</span>
        </h2>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed">
          Hourly, senior-led, no monthly lock-in. Build a team below and see your price instantly.
        </p>
      </div>

      <!-- Rate cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5 mb-8 sm:mb-10">
        {rates.map((r) => (
          <div class={`relative flex flex-col rounded-2xl border p-6 sm:p-7 transition-all duration-500 ${r.featured ? "border-orange-300 bg-white shadow-xl shadow-orange-500/5 sm:-translate-y-2" : "border-slate-200 bg-white"}`}>
            {r.featured && (
              <span class="absolute top-4 right-4 rounded-full bg-orange-500 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white">Most requested</span>
            )}
            <span class={`flex items-center justify-center w-11 h-11 rounded-xl border ${r.featured ? "bg-orange-500 border-orange-500 text-white" : "bg-orange-50 border-orange-100 text-orange-600"}`}>
              <Icon name={r.icon} class="w-5 h-5" />
            </span>
            <h3 class="mt-5 text-lg font-bold text-slate-900">{r.role}</h3>
            <div class="mt-1 flex items-baseline gap-1">
              <span class="text-4xl font-bold tracking-tight text-slate-900">{r.price}</span>
              <span class="text-sm font-semibold text-slate-400">/ hour</span>
            </div>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">{r.desc}</p>
          </div>
        ))}
      </div>

      <!-- Interactive quoter — the killer vs static price cards -->
      <TeamQuoter client:visible />
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- ACT 8 · TEAM — real faces, real profiles                      -->
  <!-- ============================================================= -->
  <section class="bg-white font-poppins pt-20 sm:pt-24 lg:pt-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-orange-50 border border-orange-200/70 text-[11px] font-semibold uppercase tracking-[0.18em] text-orange-600">
        The team
      </span>
      <h2 data-anim="heading" class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-tight">
        Real people. <span class="bg-gradient-to-r from-orange-500 to-amber-500 bg-clip-text text-transparent">Real profiles.</span>
      </h2>
      <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        No stock photos, no anonymous pool of contractors. The engineers who build your project have names, faces, and profiles you can read.
      </p>
    </div>
    <Ourteam />
  </section>

  <!-- Featured-on credibility strip -->
  <TrustBadges />

  <!-- ============================================================= -->
  <!-- ACT 9 · FAQ + FINAL CTA                                        -->
  <!-- ============================================================= -->
  <Faq />

  <section class="relative bg-slate-950 font-poppins py-20 sm:py-24 lg:py-32 overflow-hidden">
    <div class="hero-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute -top-40 left-1/3 w-[34rem] h-[34rem] bg-orange-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 data-anim="heading" class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight">
        Let's build the thing <span class="bg-gradient-to-r from-orange-400 to-amber-400 bg-clip-text text-transparent">that ships.</span>
      </h2>
      <p class="mt-5 text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Tell us the goal. You get a clear plan, an honest quote, and a first response in under two hours — Monday to Friday, US Central time.
      </p>

      <div class="mt-9 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3.5">
        <a
          href="/contact"
          class="group inline-flex items-center justify-center gap-2.5 pl-6 pr-2.5 py-2.5 rounded-full bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white text-sm sm:text-base font-semibold shadow-lg shadow-orange-500/25 transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]"
        >
          Start your project
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-white/15 transition-transform duration-300 group-hover:translate-x-0.5">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-slate-900/70 border border-slate-700 hover:border-cyan-500/50 text-slate-200 text-sm sm:text-base font-semibold transition-colors duration-300"
        >
          <Icon name="message-circle" class="w-4 h-4 text-cyan-400" />
          Chat on WhatsApp
        </a>
      </div>

      <p class="mt-6 text-xs text-slate-500">
        Currently onboarding new projects · San Pedro Sula, Honduras 🇭🇳 · Serving the US, LATAM & EU
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero-grid {
    background-image:
      linear-gradient(to right, rgba(148, 163, 184, 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(148, 163, 184, 0.07) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 90% 65% at 50% 0%, #000 40%, transparent 100%);
    mask-image: radial-gradient(ellipse 90% 65% at 50% 0%, #000 40%, transparent 100%);
  }
</style>
