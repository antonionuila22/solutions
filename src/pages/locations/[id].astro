---
export const prerender = true;
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import Whyus from "../../components/whyus.astro";
import Faq from "../../components/Faq.astro";
import PageHero from "../../components/PageHero.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { createLocalBusinessSchema } from "../../utils/schema";
import { sanitizeHtml } from "../../lib/sanitize-html";
import { isLocationHub } from "../../lib/seo/geo-tiers";
import { testimonials } from "../../data/testimonials";

export async function getStaticPaths() {
  const locations = await getCollection("locations", ({ data }) => !data.draft);

  // Ciudades que sí van al sitemap. Las de cola larga quedan fuera a propósito,
  // así que tampoco reciben enlaces desde aquí.
  const hubs = locations
    .filter((entry) => isLocationHub(entry.id))
    .sort((a, b) => a.id.localeCompare(b.id));

  // La rueda gira dentro de cada país. Si girara sobre la lista completa,
  // una página de Kansas City acabaría ofreciendo La Ceiba, que es cierto
  // pero se lee como un error.
  const byCountry = new Map<string, typeof hubs>();
  for (const entry of hubs) {
    const key = entry.data.country;
    byCountry.set(key, [...(byCountry.get(key) ?? []), entry]);
  }

  return locations.map((location) => ({
    params: { id: location.id },
    props: {
      location,
      // Cada ciudad enlaza a las tres siguientes de su país. Varias solo
      // tenían el enlace del índice /locations.
      otherCities: (() => {
        const pool = byCountry.get(location.data.country) ?? [];
        const index = pool.findIndex((entry) => entry.id === location.id);
        if (index < 0 || pool.length < 2) return [];
        // Same state or department first (the real neighbours), then the
        // rotation over the rest of the country so every city gets links.
        const sameRegion = pool.filter((entry) => entry.id !== location.id && !!location.data.region && entry.data.region === location.data.region);
        const rotated = [1, 2, 3, 4, 5]
          .filter((offset) => offset < pool.length)
          .map((offset) => pool[(index + offset) % pool.length])
          .filter((entry) => !sameRegion.includes(entry));
        return [...sameRegion, ...rotated].slice(0, 3);
      })(),
    },
  }));
}

const { location, otherCities = [] } = Astro.props;
const { data } = location;

// Parent pages for the breadcrumb trail (country and region hubs), so every city
// links up to its cluster and crawlers reach the geo hierarchy from any page.
const countryEntry = (await getCollection("countryareas")).find((entry) => entry.id === data.country);
const regionEntry = data.region ? (await getCollection("regions")).find((entry) => entry.id === data.region) : undefined;
const {
  title,
  description,
  city,
  state,
  stateCode,
  region,
  img,
  imageAlt,
  population,
  timezone,
  keywords,
  // New SEO fields
  metaTitle,
  longDescription,
  industries,
  marketHighlights,
  faqs,
  whyChooseUs,
  nearbyAreas,
  localStats,
  // Differentiation fields (per-city unique content + structure)
  techScene,
  localServices,
  localCaseStudy,
  localTestimonial
} = data;

// ── Language: every location outside the US is written in Spanish. The page
//    chrome (H1, headings, CTAs, fallbacks) must match the content language or
//    Google reads a mixed-language page. ─────────────────────────────────────
const isSpanish = data.country !== "usa";
// "San Salvador, San Salvador" reads like a template glitch when city and state share a name.
const place = city === state ? city : `${city}, ${state}`;
const waText = encodeURIComponent(`Hola Codebrand, tengo un proyecto web en ${city} y quiero una propuesta.`);
const whatsappUrl = `https://api.whatsapp.com/send/?phone=50487380714&text=${waText}&type=phone_number&app_absent=0`;
const t = isSpanish
  ? {
      heroTitle: `Desarrollo Web Profesional en <span class="text-orange-400">${city}</span>`,
      statReviews: "50 reseñas en Google", statFive: "Reseñas de 5 estrellas", statYears: "Años de experiencia del equipo", statCustom: "Hecho a la medida",
      ctaPrimary: { text: "Solicitar propuesta", href: whatsappUrl },
      ctaSecondary: { text: "Por qué elegirnos", href: "#why-codebrand" },
      longTitle: `Servicios de desarrollo web en ${place}`,
      industriesTitle: `Industrias que atendemos en ${city}`,
      industriesSub: `Entendemos las necesidades digitales de los negocios de ${city}.`,
      marketTitle: `Por qué ${city} es un buen lugar para hacer negocios digitales`,
      statsTech: `Empresas tecnológicas en ${city}`, statsGrowth: "Crecimiento empresarial",
      techTitle: `El ecosistema tecnológico y empresarial de ${city}`,
      whyTitle: `Por qué las empresas de ${city} eligen Codebrand`,
      whyIntro: `Somos una agencia de desarrollo web con base en Honduras que trabaja con empresas de ${city} en su idioma, con calidad de exportación y una propuesta de precio cerrado según su presupuesto.`,
      servicesTitle: `Servicios de desarrollo web para empresas de ${city}`,
      servicesSub: `Desde emprendimientos hasta empresas consolidadas: sitios web, tiendas en línea y sistemas a la medida para el mercado de ${city}.`,
      learnMore: "Más información",
      caseEyebrow: "Caso real de un cliente", caseLink: "Ver este proyecto", clientLabel: "Cliente",
      reviewsTitle: "Lo que dicen nuestros clientes", reviewsSub: "Reseñas verificadas de 5 estrellas de negocios para los que hemos construido.",
      ctaTitle: `¿Listo para iniciar su proyecto web en ${city}?`,
      ctaSub: "Cuéntenos qué necesita y el presupuesto que tiene; le respondemos con una propuesta de precio cerrado. Sin compromiso.",
      ctaButton: "Solicitar propuesta", ctaButtonHref: whatsappUrl, ctaWork: "Ver nuestro trabajo",
      nearbyTitle: "También atendemos zonas cercanas", nearbySub: `Ofrecemos desarrollo web en toda el área metropolitana de ${city}.`,
      otherCities: "También trabajamos en estas ciudades",
      crumbHome: "Inicio", crumbAreas: "Áreas de servicio",
      faqTitle: `Preguntas frecuentes sobre desarrollo web en ${city}`, faqSub: `Preguntas comunes de empresas de ${city} sobre nuestros servicios.`,
    }
  : {
      heroTitle: `Professional Web Development in <span class="text-orange-400">${city}</span>`,
      statReviews: "50 Google reviews", statFive: "Five-Star Reviews", statYears: "Years Team Experience", statCustom: "Custom-Built",
      ctaPrimary: { text: "Request a Proposal", href: "/quoter/" },
      ctaSecondary: { text: "Why Choose Us", href: "#why-codebrand" },
      longTitle: `Web Development Services in ${place}`,
      industriesTitle: `Industries We Serve in ${city}`,
      industriesSub: `We understand the unique digital needs of ${city}'s diverse business landscape.`,
      marketTitle: `Why ${city} is a Great Place for Digital Business`,
      statsTech: `Tech Companies in ${city}`, statsGrowth: "Business Growth Rate",
      techTitle: `The ${city} Tech & Business Scene`,
      whyTitle: `Why ${city} Businesses Choose Codebrand`,
      whyIntro: `We're a Honduras-based web development agency serving ${city} businesses with export-quality work at a fixed price built from your budget. Same timezone, bilingual team.`,
      servicesTitle: `Web Development Services for ${city} Businesses`,
      servicesSub: `From startups to established companies, we provide comprehensive web development solutions tailored to ${city}'s business landscape.`,
      learnMore: "Learn More",
      caseEyebrow: "Real Client Success Story", caseLink: "View this project", clientLabel: "Client",
      reviewsTitle: "What Our Clients Say", reviewsSub: "Verified 5-star reviews from businesses we've built for.",
      ctaTitle: `Ready to Start Your ${city} Web Development Project?`,
      ctaSub: "Tell us what you need and the budget you have. You get a fixed-price proposal within 24 business hours. No commitment required.",
      ctaButton: "Request a Proposal", ctaButtonHref: "/quoter/", ctaWork: "View Our Work",
      nearbyTitle: "Also Serving Nearby Areas", nearbySub: `We provide web development services throughout the ${city} metropolitan area.`,
      otherCities: "We also work in these cities",
      crumbHome: "Home", crumbAreas: "Service Areas",
      faqTitle: `Frequently Asked Questions About Web Development in ${city}`, faqSub: `Common questions from ${city} businesses about our web development services.`,
    };

// Breadcrumb trail: rendered visibly and emitted as BreadcrumbList by the Layout.
const crumbItems = [
  { name: t.crumbHome, href: "/" },
  { name: t.crumbAreas, href: "/countryareas/" },
  ...(countryEntry ? [{ name: countryEntry.data.name, href: `/countryareas/${countryEntry.id}/` }] : []),
  ...(regionEntry ? [{ name: regionEntry.data.name, href: `/regions/${regionEntry.id}/` }] : []),
  { name: city, href: "" },
];

// ── Regional design accent ─────────────────────────────────────────────────
// Give pages a visual identity that varies by region/state so no two look like
// byte-identical clones. Derived deterministically from the region or stateCode.
// Complete class strings only (Tailwind can't generate interpolated names, but it
// DOES detect these literal tokens in this file).
const ACCENTS = [
  { sectionGrad: "bg-gradient-to-br from-cyan-900 to-cyan-800", ctaBg: "bg-cyan-900", chip: "bg-cyan-50 text-cyan-800 border-cyan-200" },
  { sectionGrad: "bg-gradient-to-br from-indigo-900 to-indigo-800", ctaBg: "bg-indigo-900", chip: "bg-indigo-50 text-indigo-800 border-indigo-200" },
  { sectionGrad: "bg-gradient-to-br from-emerald-900 to-emerald-800", ctaBg: "bg-emerald-900", chip: "bg-emerald-50 text-emerald-800 border-emerald-200" },
  { sectionGrad: "bg-gradient-to-br from-violet-900 to-violet-800", ctaBg: "bg-violet-900", chip: "bg-violet-50 text-violet-800 border-violet-200" },
  { sectionGrad: "bg-gradient-to-br from-rose-900 to-rose-800", ctaBg: "bg-rose-900", chip: "bg-rose-50 text-rose-800 border-rose-200" },
  { sectionGrad: "bg-gradient-to-br from-sky-900 to-sky-800", ctaBg: "bg-sky-900", chip: "bg-sky-50 text-sky-800 border-sky-200" },
];
const accentKey = (region || stateCode || city || "x").toLowerCase();
let accentHash = 0;
for (let i = 0; i < accentKey.length; i++) accentHash = (accentHash * 31 + accentKey.charCodeAt(i)) >>> 0;
const accent = ACCENTS[accentHash % ACCENTS.length];

// Alternate the section order per city (deterministic) so the page flow itself
// differs, not just the words, another anti-duplication signal.
const industriesFirst = accentHash % 2 === 0;

// ── Real, honest social proof, rotated per city ────────────────────────────
// We NEVER fabricate reviews or results. We surface genuine Google reviews and
// real delivered projects, rotated deterministically so no two city pages show
// an identical block. They are labelled as real reviews / real work, not as local.
const pickRotated = <T,>(arr: T[], count: number, seed: number): T[] => {
  if (!arr.length) return [];
  const out: T[] = [];
  const n = Math.min(count, arr.length);
  for (let i = 0; i < n; i++) out.push(arr[(seed + i) % arr.length]);
  return out;
};
const substantialReviews = testimonials.filter((t) => t.body.length >= 70);
const cityReviews = pickRotated(substantialReviews, 3, accentHash);

// Only genuine client work rotates here: the "landing-*" entries are demo
// templates, not clients. Spanish pages prefer the case studies written in Spanish.
const allProjects = (await getCollection("projects", ({ data, id }) => !data.draft && !id.startsWith("landing-") && id !== "ramonnuila-dev-portfolio"))
  .sort((a, b) => (a.id < b.id ? -1 : 1));
const spanishProjects = allProjects.filter((entry) => entry.data.lang === "es");
const englishProjects = allProjects.filter((entry) => entry.data.lang !== "es");
const realProjects = isSpanish
  ? (spanishProjects.length ? spanishProjects : allProjects)
  : (englishProjects.length ? englishProjects : allProjects);
const rotatedProject = pickRotated(realProjects, 1, accentHash)[0];
// Prefer an explicit per-city case study; otherwise use a real project (honest,
// not claimed to be local).
const caseStudy = localCaseStudy
  ? { ...localCaseStudy, href: "/projects/" }
  : rotatedProject
    ? {
        title: rotatedProject.data.title,
        summary: rotatedProject.data.description,
        metric: rotatedProject.data.results?.metric1,
        metricLabel: rotatedProject.data.client ? `${t.clientLabel}: ${rotatedProject.data.client}` : undefined,
        href: `/projects/${rotatedProject.id}/`,
      }
    : null;

// Check if we have enhanced content
const hasEnhancedContent = longDescription || industries?.length || marketHighlights?.length || faqs?.length;

// ── "Why choose us" cards: prefer per-city `whyChooseUs`; fall back to a
//    city-interpolated default so we never regress to an empty section. ──
const WHY_ICONS = [
  "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
  "M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129",
  "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
  "M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z",
  "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
];
const whyCards = (whyChooseUs && whyChooseUs.length)
  ? whyChooseUs
  : isSpanish
  ? [
      { title: "Mismo idioma, sin intermediarios", description: `Hablamos con su equipo de ${city} en español, sin traducciones ni gestores de cuenta en medio.` },
      { title: "Zona horaria compatible", description: "Trabajamos desde Honduras en horario de Centroamérica, con reuniones en su jornada laboral." },
      { title: "Precio cerrado según su presupuesto", description: "Usted define el presupuesto; nosotros proponemos el alcance que cabe y cerramos un precio fijo." },
      { title: "Tecnología actual", description: `React, Next.js, Astro, Node.js y TypeScript, el mismo stack que usan los mejores estudios de ${city}.` },
      { title: "Experiencia comprobada", description: "Proyectos entregados en Estados Unidos, Honduras, España y México, con reseñas verificables." },
      { title: "El código es suyo", description: "Propiedad total del código fuente y de las cuentas. Su sitio, su código, sin dependencia de nosotros." },
    ]
  : [
      { title: "60% Cost Savings", description: `Get the same quality as ${city} agencies at a fraction of the cost, without compromising quality.` },
      { title: "Same Timezone", description: `Honduras operates on CST, aligned with ${city}. Real-time collaboration, no overnight waits.` },
      { title: "Fluent English", description: "Our entire team speaks fluent English. Clear communication, no language barriers." },
      { title: "Latest Technologies", description: `React, Next.js, Astro, Node.js, TypeScript, the same modern stack as top ${city} shops.` },
      { title: "Proven Track Record", description: "Custom web projects delivered across the US, Honduras, Spain, and Mexico." },
      { title: "You Own Everything", description: "Complete source code ownership, no vendor lock-in. Your website, your code." },
    ];

// City-specific services override the generic block when provided.
const serviceCards = (localServices && localServices.length)
  ? localServices
  : isSpanish
  ? [
      { title: "Desarrollo web a la medida", description: `Sitios y aplicaciones en React, Next.js o Astro, rápidos y escalables, pensados para empresas de ${city}.`, href: "/web-development/" },
      { title: "Tiendas en línea", description: "Comercio electrónico completo con catálogo, carrito, pagos locales e internacionales e inventario.", href: "/e-commerce/" },
      { title: "Diseño web y UX/UI", description: `Diseños enfocados en conversión que representan a su marca de ${city} con profesionalismo.`, href: "/web-design/" },
    ]
  : [
      { title: "Custom Web Development", description: `Tailored web apps built with React, Next.js, or Astro, scalable, fast, and designed for ${city} businesses.`, href: "/web-development/" },
      { title: "E-commerce Development", description: "Full-featured online stores with Shopify, WooCommerce, or custom platforms.", href: "/e-commerce/" },
      { title: "Web Design & UI/UX", description: `Conversion-focused designs that represent your ${city} brand professionally.`, href: "/web-design/" },
    ];

// SEO optimization, keep title ≤ 70 chars and description ≤ 160 chars
// to satisfy Google's snippet limits and SE Ranking guidelines.
const seoTitle = metaTitle || (isSpanish ? `Desarrollo Web en ${city} | Codebrand` : `Web Development in ${city}, ${stateCode} | Codebrand`);
const seoDescription = description.length > 160
  ? description.slice(0, 157).replace(/\s+\S*$/, "").trimEnd() + "…"
  : description;
const seoKeywords = isSpanish ? [
  `desarrollo web ${city}`,
  `diseño web ${city}`,
  `agencia web ${city}`,
  `empresa de desarrollo web ${city}`,
  `páginas web ${city}`,
  `desarrollo de software ${city} ${state}`,
  ...(keywords || [])
].join(", ") : [
  `web development ${city}`,
  `web development company ${city}`,
  `custom web development ${city}`,
  `affordable web developers ${city}`,
  `web development services ${city} ${state}`,
  `web development agency ${city}`,
  ...(keywords || [])
].join(", ");

// Ensure absolute URL for images
const baseUrl = "https://www.codebrand.us";
const absoluteImage = img ? (img.startsWith('http') ? img : `${baseUrl}${img}`) : `${baseUrl}/photos/webservice.webp`;

// Structured Data for Local Business Service
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": isSpanish ? "Desarrollo Web" : "Web Development",
  "provider": {
    "@type": "Organization",
    "name": "Codebrand",
    "url": "https://www.codebrand.us",
    "logo": "https://www.codebrand.us/iconcodebrand.svg",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "HN",
      "addressRegion": "Cortés"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+504-8738-0714",
      "contactType": "Sales",
      "email": "info@codebrand.es",
      "availableLanguage": ["English", "Spanish"]
    }
  },
  "areaServed": {
    "@type": "City",
    "name": city,
    "containedInPlace": {
      "@type": "State",
      "name": state,
      ...(countryEntry ? { "containedInPlace": { "@type": "Country", "name": countryEntry.data.name } } : {})
    }
  },
  "description": description,
  "url": `${baseUrl}/locations/${location.id}/`,
  "image": absoluteImage
};

// LocalBusiness Schema for enhanced local SEO
const localBusinessSchema = createLocalBusinessSchema(city, state, stateCode, description, {
  slug: location.id,
  countrySlug: data.country,
  countryName: countryEntry?.data.name,
  spanish: isSpanish,
});

// FAQ Schema for SEO (only if custom FAQs exist)
const faqSchema = faqs?.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  image={absoluteImage}
  noindex={!isLocationHub(location.id)}
  lang={isSpanish ? "es" : "en-US"}
  breadcrumbs={crumbItems}
>
  <!-- Service Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <!-- LocalBusiness Schema for enhanced local SEO -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)} />

  <!-- FAQ Schema for SEO (only if custom FAQs exist) -->
  {faqSchema && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  )}

  <!-- Hero Section -->
  <PageHero
    eyebrow={place}
    title={t.heroTitle}
    subtitle={description}
    stats={[
      { value: "5.0", label: t.statReviews, counterTo: 5, decimals: 1, color: "orange" },
      { value: "50", label: t.statFive, counterTo: 50, color: "cyan" },
      { value: "8+", label: t.statYears, counterTo: 8, suffix: "+", color: "cyan" },
      { value: "100%", label: t.statCustom, color: "orange" },
    ]}
    ctaPrimary={t.ctaPrimary}
    ctaSecondary={t.ctaSecondary}
  />
  <Breadcrumbs
    items={crumbItems}
    variant="transparent"
    class="bg-slate-50 border-y border-slate-100"
  />

  <!-- Extended Description Section (SEO Content) -->
  {longDescription && (
    <section class="py-16 lg:py-24 bg-slate-50 font-poppins">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-lg prose-cyan max-w-none">
          <h2 class="text-display-2 font-bold text-cyan-900 mb-8 text-center" data-anim="heading">
            {t.longTitle}
          </h2>
          <div class="text-slate-700 leading-relaxed text-lg space-y-6" data-anim="fade" set:html={sanitizeHtml(longDescription || '')} />
        </div>
      </div>
    </section>
  )}

  <!-- Local Industries Section -->
  {industries && industries.length > 0 && (
    <section class="py-16 lg:py-24 bg-white font-poppins">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-display-2 font-bold text-cyan-900 mb-4" data-anim="heading">
            {t.industriesTitle}
          </h2>
          <p class="text-xl text-slate-600 max-w-3xl mx-auto" data-anim="fade" data-delay="0.1">
            {t.industriesSub}
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-anim="fade">
          {industries.map((industry) => (
            <div class="bg-slate-50 p-6 rounded-xl border border-slate-100 hover:border-cyan-200 hover:shadow-md transition-all">
              <h3 class="text-xl font-bold text-cyan-900 mb-2">{industry.name}</h3>
              {industry.description && (
                <p class="text-slate-600">{industry.description}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Market Highlights Section -->
  {marketHighlights && marketHighlights.length > 0 && (
    <section class={`py-16 lg:py-20 ${accent.sectionGrad} font-poppins`}>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-display-2 font-bold text-white mb-4" data-anim="heading">
            {t.marketTitle}
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto" data-anim="fade">
          {marketHighlights.map((highlight) => (
            <div class="flex items-start gap-4 bg-white/10 backdrop-blur-sm p-5 rounded-xl">
              <div class="flex-shrink-0 w-8 h-8 bg-orange-500 rounded-full flex items-center justify-center">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <p class="text-white text-lg">{highlight}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Local Stats Section -->
  {localStats && (localStats.techCompanies || localStats.businessGrowth) && (
    <section class="py-12 bg-white font-poppins border-b border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center" data-anim="fade">
          {localStats.techCompanies && (
            <div>
              <div class="text-4xl font-bold text-orange-500 mb-2">{localStats.techCompanies}</div>
              <div class="text-slate-600">{t.statsTech}</div>
            </div>
          )}
          {localStats.businessGrowth && (
            <div>
              <div class="text-4xl font-bold text-orange-500 mb-2">{localStats.businessGrowth}</div>
              <div class="text-slate-600">{t.statsGrowth}</div>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Local Tech / Business Scene (unique per city) -->
  {techScene && (
    <section class="py-16 lg:py-20 bg-white font-poppins">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-3xl border border-slate-100 bg-slate-50 p-8 sm:p-12">
          <h2 class="text-display-2 font-bold text-cyan-900 mb-6" data-anim="heading">
            {t.techTitle}
          </h2>
          <div class="prose prose-lg max-w-none text-slate-700 leading-relaxed" data-anim="fade" set:html={sanitizeHtml(techScene)} />
        </div>
      </div>
    </section>
  )}

  <!-- Why Codebrand for [City] Section -->
  <section class="py-16 lg:py-24 bg-white font-poppins" id="why-codebrand">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-display-2 font-bold text-cyan-900 mb-6" data-anim="heading">
          {t.whyTitle}
        </h2>
        <p class="text-xl text-slate-700 max-w-3xl mx-auto" data-anim="fade" data-delay="0.1">
          {t.whyIntro}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-anim="fade">
        {whyCards.map((card, i) => (
          <div class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow">
            <div class="w-12 h-12 bg-orange-500 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={WHY_ICONS[i % WHY_ICONS.length]}></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-cyan-900 mb-3">{card.title}</h3>
            <p class="text-slate-700">{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Services -->
  <section class="py-16 lg:py-24 bg-slate-50 font-poppins">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-display-2 font-bold text-cyan-900 mb-6" data-anim="heading">
          {t.servicesTitle}
        </h2>
        <p class="text-xl text-slate-700 max-w-3xl mx-auto" data-anim="fade" data-delay="0.1">
          {t.servicesSub}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-anim="fade">
        {serviceCards.map((svc) => (
          <div class="bg-white p-8 rounded-2xl shadow-lg">
            <h3 class="text-2xl font-bold text-cyan-900 mb-4">{svc.title}</h3>
            <p class="text-slate-700 mb-6">{svc.description}</p>
            <a href={svc.href || "/contact/"} class="text-orange-600 hover:text-orange-700 font-semibold inline-flex items-center gap-2">
              {t.learnMore}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Us Component -->
  {!isSpanish && <Whyus />}

  <!-- Real Client Success Story (a genuine delivered project, rotated per city) -->
  {caseStudy && (
    <section class="py-16 lg:py-20 bg-slate-50 font-poppins">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-3 gap-8 items-center rounded-3xl bg-white border border-slate-100 shadow-lg p-8 sm:p-12">
          <div class="md:col-span-2">
            <span class="inline-block text-xs font-bold uppercase tracking-wider text-orange-600 mb-3">
              {t.caseEyebrow}
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-cyan-900 mb-4" data-anim="heading">
              {caseStudy.title}
            </h2>
            <p class="text-slate-700 text-lg leading-relaxed mb-5" data-anim="fade">{caseStudy.summary}</p>
            <a href={caseStudy.href} class="text-orange-600 hover:text-orange-700 font-semibold inline-flex items-center gap-2">
              {t.caseLink}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
          {caseStudy.metric && (
            <div class="text-center md:border-l md:border-slate-100 md:pl-8">
              <div class="text-3xl xl:text-4xl font-bold text-orange-500">{caseStudy.metric}</div>
              {caseStudy.metricLabel && (
                <div class="text-slate-600 mt-2 text-sm">{caseStudy.metricLabel}</div>
              )}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Real Google reviews (genuine, rotated per city, not claimed to be local) -->
  {cityReviews.length > 0 && (
    <section class="py-16 lg:py-20 bg-white font-poppins">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-display-2 font-bold text-cyan-900 mb-3" data-anim="heading">
            {t.reviewsTitle}
          </h2>
          <p class="text-slate-600" data-anim="fade" data-delay="0.1">
            {t.reviewsSub}
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-anim="fade">
          {cityReviews.map((review) => (
            <figure class="flex flex-col h-full rounded-2xl border border-slate-100 bg-slate-50 p-6 shadow-sm">
              <div class="flex gap-0.5 mb-3" aria-hidden="true">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 00.95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 00-.37 1.12l1.07 3.29c.3.92-.75 1.69-1.54 1.12l-2.8-2.03a1 1 0 00-1.17 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 00-.36-1.12l-2.8-2.03c-.79-.57-.39-1.81.58-1.81h3.46a1 1 0 00.95-.69l1.07-3.29z"/></svg>
                ))}
              </div>
              <blockquote class="text-slate-700 leading-relaxed flex-1">{review.body}</blockquote>
              <figcaption class="mt-4 pt-4 border-t border-slate-200 flex items-center gap-2">
                <span class="font-semibold text-cyan-900 text-sm">{review.name}</span>
                <span class="ml-auto inline-flex items-center gap-1 text-xs text-slate-400">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.24 10.4V14h5.05c-.22 1.3-.9 2.4-1.92 3.14v2.6h3.1c1.82-1.67 2.86-4.14 2.86-7.07 0-.68-.06-1.34-.18-1.97h-8.9z"/><path d="M12.24 22c2.6 0 4.78-.86 6.37-2.33l-3.1-2.4c-.86.58-1.96.92-3.27.92-2.5 0-4.62-1.69-5.38-3.96H3.66v2.48A9.6 9.6 0 0012.24 22z"/></svg>
                  {review.username}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class={`py-16 lg:py-24 ${accent.ctaBg} font-poppins`}>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-display-2 font-bold text-white mb-6" data-anim="heading">
        {t.ctaTitle}
      </h2>
      <p class="text-xl text-cyan-100 mb-8" data-anim="fade" data-delay="0.1">
        {t.ctaSub}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center" data-anim="fade" data-delay="0.18">
        <a href={t.ctaButtonHref} data-magnetic data-magnetic-strength="0.3" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-orange-500 hover:bg-orange-600 text-white rounded-2xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-300">
          {t.ctaButton}
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        <a href="/projects/" data-magnetic data-magnetic-strength="0.3" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white hover:bg-slate-100 text-cyan-900 rounded-2xl font-bold text-lg shadow-lg transition-all duration-300">
          {t.ctaWork}
        </a>
      </div>
    </div>
  </section>

  <!-- Nearby Areas Section -->
  {nearbyAreas && nearbyAreas.length > 0 && (
    <section class="py-12 bg-slate-50 font-poppins">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h2 class="text-display-2 font-bold text-cyan-900 mb-4" data-anim="heading">
            {t.nearbyTitle}
          </h2>
          <p class="text-slate-600 mb-6" data-anim="fade" data-delay="0.1">
            {t.nearbySub}
          </p>
          <div class="flex flex-wrap justify-center gap-3" data-anim="fade" data-delay="0.15">
            {nearbyAreas.map((area) => (
              <span class="px-4 py-2 bg-white rounded-full text-slate-700 border border-slate-200 hover:border-cyan-300 transition-colors">
                {area}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Other cities, internal linking between location hubs -->
  {otherCities.length > 0 && (
    <section class="py-12 bg-white font-poppins" aria-labelledby="other-cities">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h2
            id="other-cities"
            class="text-display-2 font-bold text-cyan-900 mb-6"
          >
            {t.otherCities}
          </h2>
          <ul class="flex flex-wrap justify-center gap-3 list-none p-0">
            {otherCities.map((entry) => (
              <li>
                <a
                  href={`/locations/${entry.id}/`}
                  class="inline-block px-4 py-2 bg-slate-50 rounded-full text-slate-700 border border-slate-200 transition-colors hover:border-cyan-300 hover:text-cyan-900"
                >
                  {entry.data.city || entry.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ Section -->
  {faqs && faqs.length > 0 ? (
    <section class="py-16 lg:py-24 bg-white font-poppins">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-display-2 font-bold text-cyan-900 mb-4" data-anim="heading">
            {t.faqTitle}
          </h2>
          <p class="text-xl text-slate-600" data-anim="fade" data-delay="0.1">
            {t.faqSub}
          </p>
        </div>
        <div class="space-y-6" data-anim="fade">
          {faqs.map((faq, index) => (
            <details class="group bg-slate-50 rounded-xl border border-slate-200 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-cyan-900 hover:bg-slate-100 transition-colors">
                <span class="pr-4">{faq.question}</span>
                <svg class="w-5 h-5 text-cyan-600 transform group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <div class="px-6 pb-6 text-slate-700 leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <Faq />
  )}
</Layout>
