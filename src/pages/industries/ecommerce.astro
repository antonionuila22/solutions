---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import TrustBadges from "../../components/TrustBadges.astro";
import RelatedServices from "../../components/RelatedServices.astro";
import EcomHero from "../../components/ecommerce/EcomHero.astro";
import EcomLeaks from "../../components/ecommerce/EcomLeaks.astro";
import EcomPlatforms from "../../components/ecommerce/EcomPlatforms.astro";
import EcomIncluded from "../../components/ecommerce/EcomIncluded.astro";
import EcomIntegrations from "../../components/ecommerce/EcomIntegrations.astro";
import EcomSeo from "../../components/ecommerce/EcomSeo.astro";
import EcomProcess from "../../components/ecommerce/EcomProcess.astro";
import EcomProof from "../../components/ecommerce/EcomProof.astro";
import EcomSoftware from "../../components/ecommerce/EcomSoftware.astro";
import EcomFAQ from "../../components/ecommerce/EcomFAQ.astro";
import EcomCTA from "../../components/ecommerce/EcomCTA.astro";
import StorefrontDemo from "../../components/ecommerce/islands/StorefrontDemo";
import RevenueCalculator from "../../components/ecommerce/islands/RevenueCalculator";
import PlatformPicker from "../../components/ecommerce/islands/PlatformPicker";
import { createFAQSchema } from "../../utils/schema";

/**
 * /industries/ecommerce
 *
 * Primary keyword: "ecommerce website design". The service page /e-commerce/
 * owns "e-commerce development", so this page argues the design-and-conversion
 * angle and reinforces it with Shopify, WooCommerce, headless, checkout and
 * ecommerce SEO. Three React islands carry the interactive parts: a working
 * demo store above the fold, a revenue calculator, and a platform picker.
 * FAQ prices are the published ones and are kept word for word.
 */

const title = "Ecommerce Website Design That Sells | Codebrand";
const description =
  "Ecommerce website design for US online stores: fast product pages, a checkout that converts, and SEO that ranks. Shopify, WooCommerce or headless.";
const keywords =
  "ecommerce website design, ecommerce web design, online store design, ecommerce website designer, Shopify website design, WooCommerce development, headless ecommerce, custom ecommerce website, ecommerce checkout optimization, ecommerce SEO, ecommerce conversion rate optimization, ecommerce web design agency USA";
const pageUrl = "https://www.codebrand.us/industries/ecommerce/";
const socialImage = "/photos/bannercodebrand.webp";

// ── Structured data ──────────────────────────────────────────────────────────
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Ecommerce Website Design and Development",
  "name": "Ecommerce Website Design",
  "description": description,
  "url": pageUrl,
  "mainEntityOfPage": pageUrl,
  "image": `https://www.codebrand.us${socialImage}`,
  "provider": {
    "@type": "Organization",
    "name": "Codebrand",
    "url": "https://www.codebrand.us/",
    "logo": "https://www.codebrand.us/iconcodebrand.svg"
  },
  "areaServed": { "@type": "Country", "name": "United States" },
  "audience": { "@type": "BusinessAudience", "audienceType": "Online stores and direct-to-consumer brands" },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Ecommerce website services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Shopify store design", "description": "Custom Shopify themes and stores designed for conversion" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "WooCommerce development", "description": "WooCommerce stores your team can edit, built for speed" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Headless ecommerce with Astro and Next", "description": "Custom storefronts on top of Shopify or WooCommerce for speed and search" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ecommerce conversion rate optimization", "description": "Checkout, product page and cart improvements measured with real orders" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ecommerce SEO", "description": "Category and product pages structured to rank, with product schema and clean faceted navigation" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Store migration", "description": "Platform migrations with URL maps and redirects so rankings survive" }}
    ]
  }
};

// ── Hero ─────────────────────────────────────────────────────────────────────
const heroProof = [
  { value: "5.0", label: "Google rating, 50 reviews" },
  { value: "6 to 10", label: "weeks to launch a store" },
  { value: "90 days", label: "post-launch support included" },
  { value: "3", label: "platforms, one honest recommendation" },
];

// ── Leaks ────────────────────────────────────────────────────────────────────
const leaks = [
  { title: "Product pages that load slowly on a phone", body: "Most store traffic is mobile and impatient. A page that takes seconds to show the price and the buy button has already lost the shopper who came from an ad they paid for." },
  { title: "A checkout that asks for an account first", body: "Forced registration is the fastest way to turn a full cart into an abandoned one. Guest checkout, express pay and three screens at most." },
  { title: "Site search that returns nothing", body: "A shopper who types shows intent. If search cannot handle a typo, a synonym or a size, that intent walks to a competitor with better search." },
  { title: "Product pages that do not answer the question", body: "Will it fit, when does it arrive, what if I return it. If the answer is not next to the buy button, the shopper leaves to find it and does not come back." },
  { title: "No proof at the moment of doubt", body: "Reviews with photos, a visible returns policy, real delivery dates. Doubt happens at the cart, so the proof has to live there too." },
  { title: "Nobody captures the visitor who is not ready", body: "Most first visits do not buy. Back-in-stock alerts, a cart reminder and one honest email capture are what turn that visit into a second one." },
];

// ── Platforms ────────────────────────────────────────────────────────────────
const platforms = [
  {
    name: "Shopify",
    tagline: "The fastest path to a store that takes money.",
    pros: ["Checkout, taxes, fraud and hosting handled for you", "Stays up during a sale or a viral post", "Deep app ecosystem for reviews, email, subscriptions"],
    cons: ["Monthly fee plus a transaction cut", "Deep customization hits platform limits", "B2B pricing and quoting get awkward"],
    pick: "you sell standard retail, want to launch in weeks and would rather pay a fee than manage a server.",
  },
  {
    name: "WooCommerce",
    tagline: "Your store, on hosting you control.",
    pros: ["No platform fee, no transaction cut", "Your team edits everything in WordPress", "Extensions for wholesale, bundles, subscriptions"],
    cons: ["Speed and security are ongoing work", "More moving parts to keep updated", "Needs solid hosting to stay fast"],
    pick: "your team publishes constantly, you want the lowest running cost, or you need wholesale rules a plugin can cover.",
  },
  {
    name: "Headless with Astro or Next",
    tagline: "A custom storefront on top of the platform you already run.",
    pros: ["Product pages that render in milliseconds", "Search and speed scores Google rewards", "Business rules as code: B2B pricing, quotes, ERP"],
    cons: ["Highest build cost of the three", "Changes to structure need a developer", "Overkill for a small catalog"],
    pick: "you have a large catalog, live on organic search, or your pricing and ordering rules are the business.",
  },
];

// ── Included ─────────────────────────────────────────────────────────────────
const included = [
  { title: "Product page built for the buy button", note: "Price, variants, stock, delivery date and returns policy visible without scrolling. Photos that zoom and load fast." },
  { title: "Category pages that rank and filter", note: "Filters shoppers use, structured so Google indexes the category and not ten thousand filter combinations." },
  { title: "Site search that forgives", note: "Typos, synonyms, sizes and SKUs. Results in under a second, with a zero-results page that still sells." },
  { title: "Checkout in three screens or fewer", note: "Guest checkout, address autocomplete, Apple Pay, Google Pay and PayPal, the total visible the whole time." },
  { title: "A cart that grows the order honestly", note: "Free-shipping progress bar, one relevant add-on, no dark patterns. The demo above is the pattern." },
  { title: "Reviews with photos and sources", note: "Collected after delivery, shown with the reviewer's name and where the review came from." },
  { title: "Shipping and returns, answered up front", note: "Real delivery estimates by zip code and a returns page a shopper can read in thirty seconds." },
  { title: "Email and SMS capture that earns its place", note: "Back-in-stock, abandoned cart and one welcome offer. Connected to Klaviyo, Mailchimp or whichever you use." },
  { title: "Taxes and shipping rates configured", note: "Sales tax by state, carrier rates or flat rules, and the edge cases tested before launch." },
  { title: "Product schema and a Google Shopping feed", note: "Price, availability and reviews in the search results, and a clean feed for Shopping and Meta catalogs." },
  { title: "Analytics that records purchases", note: "GA4 ecommerce events, add to cart, checkout steps and purchases, checked against real orders." },
  { title: "Fast at launch, measured on a phone", note: "Core Web Vitals in the green on launch day, tested over cellular, not on office fiber." },
];

// ── Integrations ─────────────────────────────────────────────────────────────
const integrations = [
  { name: "Payments", items: ["Stripe", "PayPal", "Apple Pay", "Google Pay", "Square", "Authorize.net", "Affirm", "Klarna"] },
  { name: "Shipping", items: ["ShipStation", "EasyPost", "UPS", "FedEx", "USPS", "Shippo"] },
  { name: "Tax and accounting", items: ["TaxJar", "Avalara", "QuickBooks", "NetSuite"] },
  { name: "Email and SMS", items: ["Klaviyo", "Mailchimp", "Postscript", "Attentive"] },
  { name: "Reviews", items: ["Judge.me", "Yotpo", "Okendo", "Google reviews"] },
  { name: "Marketplaces and ads", items: ["Amazon", "Google Shopping", "Meta catalog", "TikTok Shop"] },
  { name: "Inventory and POS", items: ["Square POS", "Shopify POS", "Cin7", "Custom ERP"] },
  { name: "Support", items: ["Gorgias", "Zendesk", "Intercom", "WhatsApp"] },
];

// ── Ecommerce SEO ────────────────────────────────────────────────────────────
const seoItems = [
  { title: "Category pages as landing pages", body: "The category is what ranks for the money terms. Each one gets real copy, a clear H1, internal links and a URL that does not change when a filter is applied." },
  { title: "Product schema Google actually shows", body: "Price, availability, ratings and shipping in the result itself. Kept in sync with stock so Google never shows a price you no longer charge." },
  { title: "Faceted navigation without index bloat", body: "Filters for shoppers, canonicals and noindex rules for crawlers. Ten thousand filter URLs do not become ten thousand thin pages." },
  { title: "Core Web Vitals in the green", body: "Images sized and lazy-loaded, scripts deferred, no layout shift when the price loads. Speed is a ranking factor and a conversion factor at the same time." },
  { title: "Migrations that keep the rankings", body: "A full URL map before anything moves, redirects tested, and rankings tracked through the switch. Nobody should lose page one to a replatform." },
  { title: "Content that feeds the products", body: "Buying guides and comparisons that answer the search, linking to the categories and products they mention. Traffic that arrives ready to compare." },
];

// ── Process ──────────────────────────────────────────────────────────────────
const processSteps = [
  { when: "Week 0", title: "Store audit and a written plan", body: "We look at your current store on a phone, the checkout, your analytics and the competitors ranking for your categories. You get a short plan with a price." },
  { when: "Weeks 1 to 3", title: "Design in Figma, approved before we build", body: "Home, category, product and checkout, designed on your brand with your real products. You approve the screens before any code is written." },
  { when: "Weeks 3 to 7", title: "Build and integrations", body: "The store is built page by page and connected to payments, shipping, tax, email and whatever runs your back office. Every integration is tested with real orders." },
  { when: "Weeks 7 to 9", title: "Products, content and QA", body: "Catalog loaded, search tuned, schema validated, analytics checked against test purchases. Then a full pass on real phones over cellular." },
  { when: "Week 10, then 90 days", title: "Launch and support", body: "We launch outside your busiest days, keep the old store reachable until orders flow, and stay on for ninety days of support included." },
];

// ── Proof ────────────────────────────────────────────────────────────────────
const proofFacts = [
  { value: "7,900+", label: "products loaded" },
  { value: "6", label: "product categories" },
  { value: "1", label: "custom CRM plugin" },
];
const proofWork = [
  "WooCommerce B2B platform with quote-only checkout instead of card payments",
  "7,900+ products structured across six categories with attribute filters",
  "Custom CRM plugin so quote requests land in the sales pipeline automatically",
  "Built to be run by the client's team after handover",
];

// ── Software (secondary) ─────────────────────────────────────────────────────
const softwareSystems = [
  { name: "ERP and accounting integration", description: "A dependable bridge between the storefront and the system of record, so orders, invoices and stock movements post themselves instead of being exported by hand.", capabilities: ["Order, invoice and credit-note sync", "Product and price list mapping", "Customer and tax code alignment", "Failed-sync alerting and safe replay"] },
  { name: "Multichannel inventory and orders", description: "One stock figure across every channel and warehouse, with allocation rules that decide where an order should actually ship from.", capabilities: ["Real-time stock across channels and locations", "Allocation, backorder and safety-stock rules", "Purchase orders and inbound receiving", "Kits, bundles and serialized items"] },
  { name: "B2B pricing and customer portal", description: "Contract pricing, credit terms and reordering for wholesale accounts, in a portal built for a buyer placing their fortieth order.", capabilities: ["Account-specific price lists and tiers", "Credit limits and net payment terms", "Fast reorder from order history", "Multi-user accounts with approval rules"] },
  { name: "Quote and RFQ system", description: "Structured quoting for orders too large or too configurable to check out normally, with the approved quote turning straight into an order.", capabilities: ["Quote request capture and routing", "Margin guardrails and approval thresholds", "Quote versioning and expiry", "One-click conversion to a live order"] },
  { name: "Marketplace listing sync", description: "Listings, pricing and stock kept in step across the marketplaces you sell on, with orders landing back in the same queue as your own.", capabilities: ["Listing creation and attribute mapping", "Price and stock push per channel", "Marketplace order ingestion", "Per-channel margin and fee reporting"] },
  { name: "Fulfillment, shipping and returns", description: "Pick, pack and label without retyping addresses, and a returns flow that gives the customer a label while giving you the reason data.", capabilities: ["Pick lists, packing and label generation", "Carrier rate shopping and tracking updates", "Customer-initiated returns with reason codes", "Restock, refund and exchange workflows"] },
];

// ── FAQ ──────────────────────────────────────────────────────────────────────
// The first nine answers carry the published prices and timelines and are kept
// word for word. The rest are the questions store owners ask on the call.
const ecommerceFaqs = [
  {
    question: "How much does an e-commerce website cost?",
    answer: "E-commerce websites start at $5,000 for a basic store with essential features. Custom stores with advanced functionality range from $10,000-$25,000+. We provide detailed quotes based on your specific requirements, including product catalog size, payment integrations, and custom features needed."
  },
  {
    question: "Which e-commerce platform do you recommend?",
    answer: "It depends on your needs. For quick launches, Shopify is excellent. For WordPress users, WooCommerce offers flexibility. For high-volume stores, we build custom headless solutions. We'll recommend the best platform after understanding your business goals and budget."
  },
  {
    question: "How long does it take to build an online store?",
    answer: "A standard e-commerce store takes 6-10 weeks. This includes design, development, product upload, payment integration, and testing. Complex custom stores may take 12-16 weeks. We set clear milestones and keep you updated throughout the process."
  },
  {
    question: "Can you integrate with my existing inventory system?",
    answer: "Yes. We integrate with popular inventory management systems, ERPs, and POS systems. Whether you use NetSuite, QuickBooks, Square, or custom software, we can sync your inventory, orders, and customer data seamlessly."
  },
  {
    question: "Do you provide ongoing support after launch?",
    answer: "Absolutely. Every e-commerce project includes 90 days of post-launch support. We also offer monthly maintenance plans that include security updates, performance monitoring, and technical support to keep your store running smoothly."
  },
  {
    question: "Can you help increase my store's conversion rate?",
    answer: "Yes. We build stores optimized for conversions from day one, including streamlined checkout, trust badges, and mobile optimization. We also offer conversion rate optimization (CRO) services with A/B testing and analytics to continuously improve your sales."
  },
  {
    question: "How much does custom e-commerce software development cost?",
    answer: "We bill by the hour and by role: Mid developer $45/hr, Senior developer $65/hr, and Lead/Architect $95/hr. Back-office work is usually phased, so most merchants fund the integration or module causing the most manual work first, measure what it saves, and then decide on the next one. Hourly billing with transparent time reporting means the scope can shift as you learn, without renegotiating a fixed contract every time priorities change."
  },
  {
    question: "We already use Shopify or WooCommerce. Do we have to replace it?",
    answer: "No, and you usually should not. The storefront platform is rarely the problem once a store is growing. The gap is normally between the storefront and the ERP, the warehouse, or the wholesale side of the business. We build that layer, whether it is an integration service, an order management system, a B2B portal, or a quoting tool, and connect it through official APIs and webhooks so your existing platform keeps doing what it already does well."
  },
  {
    question: "Who owns the integrations and custom modules you build?",
    answer: "You own all of it: source code, repositories, integration logic, and documentation, hosted in your own infrastructure. That matters most for integrations, because the mapping between your storefront, ERP, and marketplaces is genuinely valuable business logic. If you ever change agencies or bring development in-house, the work transfers with the repository and there is no per-connector licence to keep paying."
  },
  {
    question: "Will my store be fast on mobile?",
    answer: "Yes, and we test it the way your customers experience it: on a real phone over cellular data, not on a desktop over office wifi. Core Web Vitals are in the green at launch on every page type, and we keep measuring after launch because a slow store is a store that stops selling."
  },
  {
    question: "Can you migrate my store to a new platform without losing Google rankings?",
    answer: "Yes. Before anything moves we map every existing URL to its new one, set up the redirects, carry over titles, descriptions and product schema, and track rankings through the switch. The goal of a migration is that Google barely notices, and the sales certainly do not."
  },
  {
    question: "Do you build B2B or wholesale stores?",
    answer: "Yes. Account-specific pricing, net payment terms, quote requests instead of card checkout, and fast reordering for buyers who place the same order every month. We have built B2B catalogs with thousands of products on WooCommerce and as custom headless storefronts."
  },
  {
    question: "Can you connect my store to Amazon, Google Shopping and Meta?",
    answer: "Yes. We set up the product feeds for Google Shopping and Meta catalogs, and for Amazon we sync listings, prices and stock so a sale on one channel updates the others. Orders from every channel land in the same queue."
  },
  {
    question: "Will I be able to manage products and content myself?",
    answer: "On Shopify and WooCommerce, yes: products, prices, stock, pages and promotions are yours to edit, and training is included at launch. On a headless build, the catalog still lives in the platform your team already knows; only the storefront code is ours to maintain."
  },
];

const faqSchema = createFAQSchema(ecommerceFaqs);
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  image={socialImage}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <EcomHero
    eyebrow="Ecommerce website design · United States"
    heading="Ecommerce website design built to turn visitors into orders"
    subtitle="We design and build online stores for US brands: product pages that load in under a second on a phone, a checkout that does not lose people, and the structure that puts your categories on page one. Shopify, WooCommerce or headless with Astro and Next, whichever your store actually needs."
    primaryHref="/contact/"
    primaryText="Get a free store audit"
    secondaryHref="#demo"
    secondaryText="Try the demo store"
    stageCaption="A working store, right here: add products, watch the shipping bar, run the checkout. This is the pattern every store we build follows."
    proof={heroProof}
  >
    <StorefrontDemo client:load />
  </EcomHero>

  <Breadcrumbs
    items={[
      { name: "Home", href: "/" },
      { name: "Industries", href: "/industries/" },
      { name: "Ecommerce", href: "" }
    ]}
    variant="light"
  />

  <EcomLeaks
    eyebrow="Where stores leak revenue"
    heading="Six places an online store loses the sale, and what we build instead"
    intro="Traffic is expensive. Most stores do not have a traffic problem; they have a leak between the click and the order. These are the six we find most often, and below them, what a leak is worth to you in your own numbers."
    leaks={leaks}
  >
    <RevenueCalculator client:visible />
  </EcomLeaks>

  <EcomPlatforms
    eyebrow="Shopify, WooCommerce or headless"
    heading="The platform decision, with the catch of each one"
    intro="There is no best platform, only the right one for a catalog, a team and a budget. We build on all three, so the recommendation is not a sales pitch for the one we happen to know."
    platforms={platforms}
  >
    <PlatformPicker client:visible />
  </EcomPlatforms>

  <EcomIncluded
    eyebrow="Included"
    heading="Every store we build ships with these"
    intro="Not add-ons, not a premium tier. This is the baseline for an online store that has to sell, and it is in every quote we send."
    items={included}
  />

  <EcomIntegrations
    eyebrow="Integrations"
    heading="Connected to the tools your store already runs on"
    intro="Payments, shipping, tax, email, reviews and the marketplaces you sell on. The store is the front door; these are the rooms behind it."
    groups={integrations}
  />

  <EcomSeo
    eyebrow="Ecommerce SEO"
    heading="Built to rank for the categories your customers search"
    intro="Ecommerce SEO is mostly structure: what ranks is the category page, what converts is the product page, and what breaks both is a thousand filter URLs Google should never have seen. We build the structure in, not on top."
    items={seoItems}
  />

  <EcomProcess
    eyebrow="How it works"
    heading="From audit to launch in six to ten weeks"
    intro="A fixed sequence with a fixed price. You approve the design before we build, every integration is tested with real orders, and support runs ninety days past launch."
    steps={processSteps}
  />

  <EcomProof
    eyebrow="Proof"
    heading="A 7,900-product B2B catalog with quote-only checkout"
    summary="A laboratory equipment distributor needed a catalog their sales team could quote from, not a cart that takes cards. We built it on WooCommerce with a quote flow instead of checkout and a custom plugin that pushes every request into their CRM."
    facts={proofFacts}
    factsNote="Scope figures from our delivery record for a platform built in 2024. They describe what was built, not sales or lead outcomes, which we do not publish for this project."
    work={proofWork}
    caseHref="/projects/laboratory-equipment-platform/"
    caseText="Read the case study"
    rating="5.0"
    reviewCount="50"
    reviewsUrl="https://g.page/r/codebrand/review"
    ratingBody="Every review from a client we shipped for. Read them the way your customers read yours."
  />

  <TrustBadges title="Also rated on" />

  <EcomSoftware
    eyebrow="Beyond the storefront"
    heading="When the store is fine and the back office is the bottleneck"
    intro="Past a certain volume the storefront stops being the problem and everything behind it becomes one: stock, pricing, quotes, returns. These are the systems we build, extend and connect."
    systems={softwareSystems}
    ctaHref="/custom-software-development/"
    ctaText="See custom software"
  />

  <EcomFAQ
    eyebrow="FAQ"
    heading="Questions store owners ask us"
    faqs={ecommerceFaqs}
  />

  <EcomCTA
    heading="Get a free audit of your online store"
    body="Send us the URL. Within two business days you get back where the store is losing orders and what we would fix first, with a price. No slides, no pressure."
    checks={[
      "Speed of your product and category pages on a phone over cellular",
      "Every step of your checkout, counted and timed",
      "Whether your product pages answer size, delivery and returns",
      "Category SEO, product schema and what Google is indexing",
      "Whether your analytics actually records purchases",
    ]}
    primaryHref="/contact/"
    primaryText="Request the free audit"
  />

  <RelatedServices currentService="e-commerce" />
</Layout>
