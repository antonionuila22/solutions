---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import TrustBadges from "../../components/TrustBadges.astro";
import RelatedServices from "../../components/RelatedServices.astro";
import RoofingHero from "../../components/roofing/RoofingHero.astro";
import RoofingAnatomy from "../../components/roofing/RoofingAnatomy.astro";
import RoofingCaseStudy from "../../components/roofing/RoofingCaseStudy.astro";
import RoofingIncluded from "../../components/roofing/RoofingIncluded.astro";
import RoofingLocalSeo from "../../components/roofing/RoofingLocalSeo.astro";
import RoofingProcess from "../../components/roofing/RoofingProcess.astro";
import RoofingSoftware from "../../components/roofing/RoofingSoftware.astro";
import RoofingTestimonial from "../../components/roofing/RoofingTestimonial.astro";
import RoofingFAQ from "../../components/roofing/RoofingFAQ.astro";
import RoofingCTA from "../../components/roofing/RoofingCTA.astro";
import { createFAQSchema } from "../../utils/schema";

/**
 * /industries/roofing
 *
 * Websites for roofing companies, US market. The page argues one thing: a
 * roofing site is a lead machine with specific parts, and we know which parts
 * because we have built them. The page talks about the service; one named
 * client appears once, as proof, with scope counts from their sitemap and
 * never a performance or business metric. Prices in the FAQ are the published ones
 * and are not touched here.
 */

const title = "Roofing Website Design for Contractors | Codebrand";
const description =
  "Websites for roofing companies across the US, built to turn storm-season searches into booked inspections. Fast on mobile, ranked city by city.";
const keywords =
  "roofing website design, roofing company website, website for roofing contractors, roofer website design, roofing contractor website design, roofing web design agency, roofing website redesign, local SEO for roofers, storm damage landing page, roofing lead generation website, roofing company web design USA";
const pageUrl = "https://www.codebrand.us/industries/roofing/";
const socialImage = "/photos/bannercodebrand.webp";

// ── Structured data ──────────────────────────────────────────────────────────
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Roofing Website Design and Development",
  "name": "Roofing Website Design for Contractors",
  "description": description,
  "url": pageUrl,
  "mainEntityOfPage": pageUrl,
  "image": `https://www.codebrand.us${socialImage}`,
  "provider": {
    "@type": "Organization",
    "name": "Codebrand",
    "url": "https://www.codebrand.us/",
    "logo": "https://www.codebrand.us/iconcodebrand.svg"
  },
  "areaServed": { "@type": "Country", "name": "United States" },
  "audience": { "@type": "BusinessAudience", "audienceType": "Roofing contractors and roofing companies" },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Roofing website services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Roofing website design", "description": "New websites for roofing companies, designed to convert searches into inspection requests" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Roofing website redesign", "description": "Redesign and cleanup of existing roofing websites, keeping URLs and rankings" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Local SEO for roofers", "description": "City and service-area pages, Google Business Profile and structured data for roofing contractors" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Roofing software", "description": "Estimating, scheduling, claims and crew systems connected to the website" }}
    ]
  }
};

// ── Hero ─────────────────────────────────────────────────────────────────────
const heroProof = [
  { value: "5.0", label: "Google rating, 50 reviews" },
  { value: "4 to 6", label: "weeks from first call to launch" },
  { value: "12", label: "features included in every site" },
  { value: "All 50", label: "states, on a US time zone" },
];

// ── Anatomy ──────────────────────────────────────────────────────────────────
const anatomyParts = [
  {
    name: "A call bar that never scrolls away",
    why: "Your phone number and a Free Inspection button on every screen. Most roofing searches happen on a phone, right after a storm or a leak, and the visitor decides in seconds. If the number is not on the screen they are looking at, it does not exist.",
  },
  {
    name: "A storm-damage page, built before the storm",
    why: "Written and waiting. When a hail cell moves through, it goes live within the hour with the date, the affected cities and the insurance-claim steps. Your competitors are still writing theirs.",
  },
  {
    name: "One page per city you serve",
    why: "Demand arrives with a city attached: roof repair Conroe TX, roofers in Cypress. One page that lists twenty towns in a paragraph competes with none of them. Twenty pages compete with all of them.",
  },
  {
    name: "A proof wall with names and sources",
    why: "Reviews with the reviewer's name, the date and where the review came from. Manufacturer certifications with a link to verify them. A new roof is a capital expense, and the buyer is looking for reasons to believe, not for a nicer layout.",
  },
  {
    name: "A gallery built for job photos",
    why: "Real roofs in real neighborhoods, before and after, sized so they load fast on cellular data. A stock photo of a smiling crew convinces nobody.",
  },
  {
    name: "Financing and insurance, answered up front",
    why: "The two questions homeowners ask first. Monthly payment options and a plain-language claim guide keep them on your site instead of the next one on the results page.",
  },
  {
    name: "Commercial and residential kept apart",
    why: "A property manager authorising a warehouse roof and a homeowner with a leak behave nothing alike. Put both on one Services page and the commercial buyer, the one worth more, assumes you are a residential shop that also does flat roofs.",
  },
  {
    name: "A form that asks for three things",
    why: "Address, what is wrong with the roof, and a phone number. Every extra field costs leads. The submission reaches your sales rep as a text message, not an inbox nobody checks after five.",
  },
];

// ── Case study: Noble Roofing ────────────────────────────────────────────────
const nobleSummary =
  "A commercial roofing contractor in Greater Houston came to us with a WordPress site that had grown to 209 pages but had drifted away from the brand: inconsistent from page to page, and not reading as a clean, established company. The job was a full redesign and cleanup of the existing site, keeping every URL that already ranked.";
const nobleWork = [
  "Brand-consistent design system applied across the whole site: type, color, spacing and components",
  "Page templates cleaned up so every service, city and building-type page follows the same structure",
  "Commercial placed first in the hierarchy on the homepage and in navigation, residential second",
  "Homepage message rebuilt around service, qualifier, city and region, in that order",
  "Review carousel with every review attributed to its source, Google or NiceJob",
  "Manufacturer partner logos and an accreditation list that links out so claims can be checked",
];
const nobleFacts = [
  { value: "209", label: "pages in the sitemap" },
  { value: "21", label: "cities with their own page" },
  { value: "13", label: "building-type pages" },
  { value: "5", label: "roofing-system pages" },
  { value: "28", label: "published articles" },
  { value: "29", label: "attributed reviews" },
];
const nobleFactsNote =
  "Scope figures counted by Codebrand from nobleroofing.co's sitemap in July 2026. They describe the size of the site we redesigned, not traffic, rankings or leads, which we do not publish for this project.";
const nobleOutcomes = [
  "A solid, consistent brand presence: the site now looks like one company, on every page",
  "Clearer communication to two different audiences, property managers and homeowners, without mixing them",
  "Broader keyword coverage across cities, services, building types and roofing systems",
  "Wider reach across Greater Houston, with a dedicated page for each of the 21 cities served",
];
const nobleQuote =
  "Noble Roofing has told us we are an excellent team and that they are happy with our performance.";
const nobleAttribution = "Noble Roofing, commercial roofing contractor, The Woodlands, TX";

// ── Included ─────────────────────────────────────────────────────────────────
const included = [
  { title: "Click-to-call on every screen", description: "A sticky call bar on mobile and a visible number on desktop, tracked so you know which page produced the call.", icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" },
  { title: "Storm-damage landing page", description: "A ready template you publish in minutes after a storm: date, cities hit, what to photograph, how the claim works.", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
  { title: "A page for every job type", description: "Repair, replacement, installation, inspection, coatings, gutters and storm restoration, each with its own copy and its own call to action.", icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" },
  { title: "Service-area pages, one per city", description: "Every city you serve gets its own page with real local copy, not a find-and-replace of the city name.", icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z" },
  { title: "Reviews with source attribution", description: "Google and other reviews shown with name, date and origin. The Google badge only appears on reviews that came from Google.", icon: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" },
  { title: "Job photo gallery, fast on cellular", description: "Before-and-after galleries from your own job photos, resized and compressed so they load on a phone in the field.", icon: "M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" },
  { title: "Financing and insurance pages", description: "Monthly payment options and a plain-language guide to the insurance claim, the two things a homeowner checks before calling.", icon: "M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" },
  { title: "A lead form that texts your rep", description: "Three fields. The submission goes to your sales team by text and to your CRM if you have one, with the page it came from.", icon: "M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" },
  { title: "Local SEO foundation", description: "RoofingContractor structured data with your name, address, phone, hours and service area, plus Google Business Profile wired to the site.", icon: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" },
  { title: "Fast at launch, measured", description: "Core Web Vitals in the green on launch day, checked on a real phone over cellular, not on a desktop over fiber.", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
  { title: "Editable by your office", description: "On WordPress your team edits pages the same day, with training included. On a custom build, we make the changes for you.", icon: "M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" },
  { title: "Hosting, backups and monitoring", description: "Managed hosting, SSL, daily backups and uptime monitoring are available on a care plan, so the site stays up when the storm hits.", icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" },
];

// ── Local SEO ────────────────────────────────────────────────────────────────
const seoCities = ["Plano, TX", "Tampa, FL", "Aurora, CO", "Mesa, AZ", "Marietta, GA", "Cary, NC"];
const seoExampleNote =
  "Each one is a separate URL with its own title, meta description, H1 and copy. A roofer covering twenty cities gets twenty of these, not one page with a list of towns.";
const seoSteps = [
  { title: "Start with the cities that already call you", body: "Before writing a single page we pull your Google Business Profile insights and your call logs. The cities that already produce calls get their pages first, because that is where a page turns into revenue soonest." },
  { title: "One page per city per service, with its own copy", body: "Not a template with the city name swapped in. Each page names neighborhoods, the roof types common there, the HOA rules where they exist and the storms that hit. Google can tell the difference, and so can a homeowner from Mesa reading about Mesa." },
  { title: "Google Business Profile connected to the site", body: "Categories, service areas, photos, the review link and the site link all kept consistent. The map pack is where roofers get called from, and it runs on the profile, not on the website alone." },
  { title: "Structured data Google actually reads", body: "RoofingContractor schema with your name, address, phone, hours and service area, on every page that needs it. It is what lets Google show your rating and your service area in the results." },
  { title: "Tracking that tells you which city paid off", body: "A tracking number per page and the source page on every form. At the end of the month you know which cities produced calls, and which pages to build next." },
];

// ── Process ──────────────────────────────────────────────────────────────────
const processSteps = [
  { title: "Free review of your site and lead flow", duration: "Week 0", body: "We look at your current site on a phone, your calls, your Google Business Profile and the competitors ranking in your cities. You get a short written plan with a price." },
  { title: "Design in Figma, approved before we build", duration: "Weeks 1 to 2", body: "Homepage, a service page, a city page and the storm page, designed on your brand. You approve the screens before any code is written." },
  { title: "Build the service, city and storm pages", duration: "Weeks 2 to 4", body: "The site is built page by page with real copy, your photos and your reviews. Forms, call tracking and the storm template are wired in." },
  { title: "Local SEO setup and tracking", duration: "Weeks 4 to 5", body: "Structured data, Google Business Profile, redirects from your old URLs so rankings do not drop, and call and form tracking per page." },
  { title: "Launch, then storm-season support", duration: "Week 6, then ongoing", body: "We launch outside your busiest days, train your office, and stay on to keep the site fast and up when a storm sends traffic all at once." },
];

// ── Software (secondary) ─────────────────────────────────────────────────────
const softwareSystems = [
  { name: "Estimating and aerial measurement", description: "Measurements, materials and labor turned into a priced proposal on the same visit, using your real unit costs rather than a rule of thumb.", capabilities: ["Aerial measurement report import", "Material and labor unit cost libraries", "Waste factor, pitch and complexity adjustments", "Good, better, best proposal options"] },
  { name: "Inspection scheduling and route planning", description: "Inspections booked against real availability and grouped by geography, so a rep is not crossing the county twice in one day.", capabilities: ["Territory and rep availability rules", "Route grouping by neighborhood", "Automated reminders and confirmations", "Inspection findings captured with photos"] },
  { name: "Insurance claim and supplement management", description: "The claim file kept in one place, from scope and adjuster meeting through supplements and approval, with the documentation the carrier will ask for.", capabilities: ["Claim file with carrier, adjuster and policy details", "Scope and supplement tracking with status", "Photo and damage documentation packages", "Deductible, ACV and RCV tracking"] },
  { name: "Crew dispatch and job board", description: "Who is on which roof today, what they need and what changed, without the morning phone tree.", capabilities: ["Crew assignment and daily job board", "Weather-driven rescheduling", "Mobile job packets and site notes", "Completion photos and sign-off capture"] },
  { name: "Material ordering and delivery tracking", description: "Orders placed against the approved scope and tracked to the delivery date, so material lands the day the crew does.", capabilities: ["Order generation from the approved estimate", "Supplier pricing and purchase order tracking", "Delivery date coordination with crew schedule", "Job-level material cost reconciliation"] },
  { name: "Homeowner project portal", description: "Somewhere the homeowner can see status, photos and paperwork themselves, which usually replaces most of the status phone calls.", capabilities: ["Project timeline and current status", "Photo updates from the crew", "Contract, permit and warranty documents", "Invoice viewing and online payment"] },
];

// ── FAQ ──────────────────────────────────────────────────────────────────────
// The first nine answers carry the published prices and timelines and are kept
// word for word. The rest are website questions that roofers ask on the call.
const roofingFaqs = [
  {
    question: "How much does a roofing company website cost?",
    answer: "A professional roofing website with lead forms, service pages, and a photo gallery starts at $3,500. Sites with an instant roof estimate tool or booking system range from $8,000-$20,000. Full job management platforms with CRM and crew scheduling are $25,000+. We quote based on your goals and service area."
  },
  {
    question: "Can you build an instant roof estimate or quote tool?",
    answer: "Yes. We build online estimate tools that let homeowners get a ballpark price from their address and roof details. We can integrate aerial measurement data (EagleView, Nearmap, Google) so the numbers are accurate, and route qualified leads straight to your sales team."
  },
  {
    question: "Will my roofing website generate more leads?",
    answer: "That's the goal. We build for conversions: click-to-call, fast quote forms, storm-damage landing pages, financing offers, and local SEO so you rank for 'roofers near me.' Every page is designed to turn traffic into booked inspections."
  },
  {
    question: "Do you integrate with roofing tools like JobNimbus or AccuLynx?",
    answer: "Absolutely. We integrate with industry platforms including JobNimbus, AccuLynx, CompanyCam, EagleView, and QuickBooks. Leads, measurements, photos, and invoices flow between your website and the tools your crews already use."
  },
  {
    question: "Can homeowners book a free roof inspection online?",
    answer: "Yes. We add real-time scheduling so homeowners pick an inspection slot that syncs with your team's calendar. Automated reminders reduce no-shows and keep your sales pipeline full."
  },
  {
    question: "How fast can you launch a roofing website?",
    answer: "A professional roofing website launches in 4-6 weeks. Sites with estimate tools or booking systems take 8-12 weeks. Full custom job management platforms take 16-24 weeks depending on scope and integrations."
  },
  {
    question: "How much does custom roofing software development cost?",
    answer: "We bill by the hour and by role: Mid developer $45/hr, Senior developer $65/hr, and Lead/Architect $95/hr. Roofers usually start with the step where jobs leak margin, most often estimating or supplement tracking, and extend from there. Hourly billing with transparent time reporting means you can fund one module per phase, put it in front of your crews and sales reps, and let what you learn shape the next phase instead of specifying everything up front."
  },
  {
    question: "Can custom software work with JobNimbus, AccuLynx, or the tools we already use?",
    answer: "Yes, and that is usually the better starting point. If your team already lives in JobNimbus, AccuLynx, or CompanyCam, replacing it creates change management you do not need. We build the missing piece instead, such as claim and supplement tracking, material reconciliation, or a homeowner portal, and connect it through supported APIs so jobs, photos, and documents stay in sync with the tool your crews already open every morning."
  },
  {
    question: "Who owns the software, and can we keep using it as we grow?",
    answer: "You own the code, the database, and the documentation from the first commit, hosted in your own infrastructure. Adding crews, territories, or a second office is a configuration change in software you already own, not a bigger monthly per-user bill. If you ever change development partners or hire in-house, everything transfers with the repository, and there is no vendor holding your job history hostage."
  },
  {
    question: "Do you build roofing websites on WordPress or with custom code?",
    answer: "Both, and we will tell you which one fits. WordPress is the right call when your office publishes often: new cities, new articles, updated certifications. A custom build in Astro or Next is the right call when speed and search are the priority and the content changes less often. Either way, the site is yours."
  },
  {
    question: "Can you redesign my existing roofing website instead of starting over?",
    answer: "Yes, and often it is the better option. We keep the URLs and the content that already rank, fix the brand, the structure and the inconsistencies, and set up redirects for anything that moves so your rankings do not drop at launch. We have done this on sites with over two hundred pages."
  },
  {
    question: "Will my office be able to edit the site?",
    answer: "On WordPress, yes: your team edits text, photos and pages the same day, and training is included at launch. On a custom build, we handle the changes for you as part of a care plan, so nobody in your office needs to touch code."
  },
  {
    question: "Do you work with roofing companies outside Texas?",
    answer: "Yes. We build for roofing contractors in all 50 states. The team works on a US time zone, in English, and everything from the review call to launch happens remotely, which is how most of our roofing clients prefer it."
  },
  {
    question: "How do I know the website is actually working?",
    answer: "Because we measure it. Every page carries call tracking and every form records where it came from. You get a monthly report with calls, form submissions and rankings by city, so you can see which pages produce jobs and which ones to build next."
  },
];

// The BreadcrumbList schema comes from Layout, built from the URL. Emitting a
// second identical one here only duplicates it.
const faqSchema = createFAQSchema(roofingFaqs);
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  image={socialImage}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <RoofingHero
    eyebrow="Websites for roofing companies · United States"
    heading="Roofing websites that turn storm-season searches into booked inspections"
    subtitle="We design and build websites for roofing contractors across the US: fast on a phone, ranked city by city, and built around the one action that pays, a homeowner or property manager asking for an inspection."
    primaryHref="/contact/"
    primaryText="Get a free site review"
    secondaryHref="#anatomy"
    secondaryText="See the eight parts that get calls"
    visualCaption="The shape of every site we build: call bar, storm page, three-field form."
    proof={heroProof}
  />

  <Breadcrumbs
    items={[
      { name: "Home", href: "/" },
      { name: "Industries", href: "/industries/" },
      { name: "Roofing", href: "" }
    ]}
    variant="light"
  />

  <RoofingAnatomy
    eyebrow="What gets the call"
    heading="A roofing website is a lead machine with eight specific parts"
    intro="Most roofing sites are brochures: a logo, a photo of a crew, a paragraph about family values, and a contact page. They look fine and produce nothing. The sites that book inspections are built around the moment a homeowner searches, phone in hand, after a storm. These are the parts that do the work, and we build all of them."
    parts={anatomyParts}
  />


  <RoofingIncluded
    eyebrow="Included"
    heading="Every roofing website we build ships with these"
    intro="Not add-ons, not a premium tier. This is the baseline for a roofing site that has to produce calls, and it is in every quote we send."
    items={included}
  />

  <RoofingLocalSeo
    eyebrow="Local SEO for roofers"
    heading="Ranked city by city, because that is how roofing gets searched"
    intro="Nobody searches for a roofer in general. They search for a roofer in their town, with the job in front of it. A site that competes in twenty cities needs twenty pages, and each one has to read like it was written about that place."
    exampleCities={seoCities}
    exampleNote={seoExampleNote}
    steps={seoSteps}
  />

  <RoofingProcess
    eyebrow="How it works"
    heading="From first call to launch in four to six weeks"
    intro="A fixed sequence with a fixed price, so you know what happens and when. You approve the design before we build and you see the site before it goes live."
    steps={processSteps}
  />

  <RoofingCaseStudy
    eyebrow="Proof"
    heading="What this looks like on a real roofing site"
    client="Noble Roofing"
    location="The Woodlands, Texas"
    siteUrl="https://nobleroofing.co/"
    summary={nobleSummary}
    work={nobleWork}
    facts={nobleFacts}
    factsNote={nobleFactsNote}
    outcomes={nobleOutcomes}
    quote={nobleQuote}
    quoteAttribution={nobleAttribution}
  />

  <RoofingTestimonial
    heading="Rated 5.0 by the companies we build for"
    body="Fifty reviews on Google, every one from a client we shipped for. Read them before you call us, the way your customers read yours."
    rating="5.0"
    reviewCount="50"
    reviewsUrl="https://g.page/r/codebrand/review"
  />

  <TrustBadges title="Also rated on" />


  <RoofingSoftware
    eyebrow="When the website is not the bottleneck anymore"
    heading="Roofing software, when leads are no longer the problem"
    intro="Leads are the front door. The estimate, the claim and the crew schedule decide whether the job is profitable. When a roofing company outgrows its website, these are the systems we build, extend and connect."
    systems={softwareSystems}
    ctaHref="/custom-software-development/"
    ctaText="See custom software"
  />

  <RoofingFAQ
    eyebrow="FAQ"
    heading="Questions roofing companies ask us"
    faqs={roofingFaqs}
  />

  <RoofingCTA
    heading="Get a free review of your roofing website"
    body="Send us your site. Within two business days you get back what is costing you calls: how it loads on a phone, which city pages are missing, how you show up in the map pack, and what we would fix first. No slides, no pressure."
    bullets={[
      "Speed test on a phone over cellular, not a desktop over fiber",
      "Your rankings in the cities you actually serve",
      "What the roofers ranking above you do that your site does not",
      "A one-page written plan with a price",
    ]}
    primaryHref="/contact/"
    primaryText="Request the free review"
  />

  <RelatedServices currentService="web-development" />
</Layout>
