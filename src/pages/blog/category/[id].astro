---
/**
 * /blog/category/[slug] — editorial category listing.
 * Same shell language as /blog: editorial header, filter row, PostCard grid.
 * SEO surface unchanged (same title/description generation, noindex).
 */
export const prerender = true;
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PostCard from "../../../components/blog/PostCard.astro";
import CategoryFilter from "../../../components/blog/CategoryFilter.astro";
import { slugifyCategory, type CategoryLink } from "../../../lib/blog";

type BlogPost = CollectionEntry<"blog">;

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);

  const categoryMap = new Map<string, { name: string; posts: BlogPost[] }>();
  for (const post of allPosts) {
    for (const cat of post.data.categories ?? []) {
      const slug = slugifyCategory(cat);
      if (!categoryMap.has(slug)) {
        categoryMap.set(slug, { name: cat, posts: [] });
      }
      categoryMap.get(slug)!.posts.push(post);
    }
  }

  const allCategories = Array.from(categoryMap.entries())
    .map(([slug, { name, posts }]) => ({ slug, name, count: posts.length }))
    .sort((a, b) => b.count - a.count);

  return Array.from(categoryMap.entries()).map(([slug, { name, posts }]) => ({
    params: { id: slug },
    props: { category: name, slug, posts, allCategories },
  }));
}

interface Props {
  category: string;
  slug: string;
  posts: BlogPost[];
  allCategories: CategoryLink[];
}

const { category, slug, posts, allCategories } = Astro.props;

const sortedPosts = posts.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

const seoTitle = `${category} Articles | Codebrand Blog`;
const seoDescription = `Browse all ${posts.length} articles in the ${category} category. Expert insights on web development, design, and digital marketing from the Codebrand team.`;
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={`${category}, web development blog, digital marketing, codebrand, ${category.toLowerCase()} articles`}
  image="/photos/bannercodebrand.webp"
  noindex={true}
>
  <!-- Editorial header -->
  <section class="bg-white pt-32 pb-12 sm:pt-40 sm:pb-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumbs brings its own inner px — cancel ours so edges align -->
      <div class="-mx-4 sm:-mx-6 lg:-mx-8">
        <Breadcrumbs
          items={[
            { name: "Home", href: "/" },
            { name: "Blog", href: "/blog" },
            { name: category, href: "" },
          ]}
          variant="transparent"
        />
      </div>

      <p
        class="mt-8 text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
      >
        Category
      </p>

      <h1 class="text-hero mt-5 text-slate-900">{category}</h1>

      <p class="text-lead mt-6 max-w-2xl text-slate-600">
        {sortedPosts.length}
        {sortedPosts.length === 1 ? "article" : "articles"} in this category.
      </p>

      <div class="mt-10">
        <CategoryFilter categories={allCategories} current={slug} />
      </div>
    </div>
  </section>

  <!-- Posts grid -->
  <section class="border-t border-slate-200 bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map((post) => <PostCard post={post} />)}
      </div>

      <div class="mt-14 text-center">
        <a
          href="/blog"
          class="inline-flex items-center border-b-2 border-orange-500 pb-1 font-semibold text-slate-900 transition-colors hover:text-orange-600"
        >
          Back to all articles
        </a>
      </div>
    </div>
  </section>
</Layout>
