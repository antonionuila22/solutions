---
/**
 * /blog — editorial index.
 *
 * Design direction adapted from the MagicUI blog template (MIT): large
 * editorial typography, one big featured post, a clean grid, lots of air.
 * Recolored to the site palette (monochrome slate + #f48200 accent).
 * SEO shell is untouched: same <title>, meta description, H1 and slugs.
 */
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import Button from "../../components/Button.astro";
import PostCard from "../../components/blog/PostCard.astro";
import CategoryFilter from "../../components/blog/CategoryFilter.astro";
import { slugifyCategory, readingMinutes, formatPostDate } from "../../lib/blog";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);

// Category links for the filter row — every category that has a route.
const categoryCounts = new Map<string, { name: string; count: number }>();
for (const post of allPosts) {
  for (const cat of post.data.categories ?? []) {
    const slug = slugifyCategory(cat);
    const entry = categoryCounts.get(slug);
    if (entry) {
      entry.count += 1;
    } else {
      categoryCounts.set(slug, { name: cat, count: 1 });
    }
  }
}

const allCategories = Array.from(categoryCounts.entries())
  .map(([slug, { name, count }]) => ({ slug, name, count }))
  .sort((a, b) => b.count - a.count);

// Sort posts by date (newest first)
const posts = allPosts.sort((a, b) => {
  const dateA =
    a.data.date instanceof Date
      ? a.data.date.getTime()
      : a.data.date
        ? new Date(a.data.date).getTime()
        : 0;
  const dateB =
    b.data.date instanceof Date
      ? b.data.date.getTime()
      : b.data.date
        ? new Date(b.data.date).getTime()
        : 0;
  return dateB - dateA;
});

// Featured post (most recent) + the rest
const featuredPost = posts[0];
const regularPosts = posts.slice(1);

const featuredMinutes = featuredPost
  ? readingMinutes(featuredPost.body, featuredPost.data.readtime)
  : 0;
const featuredDate = featuredPost
  ? formatPostDate(featuredPost.data.date, {
      month: "long",
      day: "numeric",
      year: "numeric",
    })
  : "";
const featuredCategory = featuredPost?.data.categories?.[0];
---

<Layout
  title="Blog | Web Dev & Marketing Insights | Codebrand"
  description="Expert insights on web development, digital marketing, UI/UX design, and SEO. Actionable tips and best practices from our team."
  keywords="web development blog, digital marketing blog, design blog, SEO tips, business growth strategies, web design articles, digital agency blog, marketing insights, development tutorials, UX design best practices, coding tips, digital trends, technology blog, agency insights"
  image="/photos/bannercodebrand.webp"
>
  <!-- Editorial header -->
  <section class="bg-white pt-32 pb-12 sm:pt-40 sm:pb-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
      >
        Knowledge Hub
      </p>

      <h1 class="text-hero mt-5 text-slate-900">Codebrand Blog</h1>

      <p class="text-lead mt-6 max-w-2xl text-slate-600">
        Expert insights on web development, digital marketing, design trends,
        and business growth strategies. Learn from our experience building
        digital solutions for 500+ clients.
      </p>

      {
        allCategories.length > 0 && (
          <div class="mt-10">
            <CategoryFilter categories={allCategories} />
          </div>
        )
      }
    </div>
  </section>

  <!-- Featured post -->
  {
    featuredPost && (
      <section class="bg-white pb-16 sm:pb-20">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <article class="group grid gap-8 border-t border-slate-200 pt-10 sm:pt-12 lg:grid-cols-2 lg:items-center lg:gap-14">
            <a
              href={`/blog/${featuredPost.id}`}
              class="block overflow-hidden rounded-2xl bg-slate-100"
              aria-hidden="true"
              tabindex="-1"
            >
              {featuredPost.data.img && (
                <div class="aspect-[16/10] overflow-hidden">
                  <img
                    src={featuredPost.data.img}
                    alt={featuredPost.data.imageAlt || featuredPost.data.title}
                    width="960"
                    height="600"
                    class="h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-700 motion-safe:group-hover:scale-[1.03]"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                  />
                </div>
              )}
            </a>

            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-orange-700">
                Latest article{featuredCategory && ` — ${featuredCategory}`}
              </p>

              <h2 class="text-display-2 mt-4 text-slate-900">
                <a
                  href={`/blog/${featuredPost.id}`}
                  class="transition-colors group-hover:text-orange-600"
                >
                  {featuredPost.data.title}
                </a>
              </h2>

              <p class="mt-5 line-clamp-4 leading-relaxed text-slate-600">
                {featuredPost.data.description}
              </p>

              <div class="mt-6 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-slate-500">
                {featuredPost.data.author && (
                  <span class="font-medium text-slate-700">
                    By {featuredPost.data.author}
                  </span>
                )}
                {featuredPost.data.author && featuredDate && (
                  <span aria-hidden="true">&middot;</span>
                )}
                {featuredDate && <span>{featuredDate}</span>}
                <span aria-hidden="true">&middot;</span>
                <span>{featuredMinutes} min read</span>
              </div>

              <a
                href={`/blog/${featuredPost.id}`}
                class="mt-8 inline-flex items-center border-b-2 border-orange-500 pb-1 font-semibold text-slate-900 transition-colors hover:text-orange-600"
              >
                Read the article
              </a>
            </div>
          </article>
        </div>
      </section>
    )
  }

  <!-- All posts grid -->
  <section class="border-t border-slate-200 bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
      >
        All articles
      </p>
      <h2 class="text-display-2 mt-4 text-slate-900">
        Everything we have written
      </h2>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {regularPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-white py-20 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-display-2 text-slate-900">
        Ready to Transform Your Digital Presence?
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-600">
        Stop reading and start building. Let's create something amazing
        together.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button text="Start Your Project" href="/contact" />
      </div>
    </div>
  </section>
</Layout>
