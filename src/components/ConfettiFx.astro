---
/**
 * ConfettiFx — site-wide confetti triggers on canvas-confetti (MIT, ~5KB gz).
 * This is the library MagicUI's Confetti component wraps; we use it directly —
 * a click effect needs no React island.
 *
 * Usage (include this component once on any page that uses either trigger):
 *  - <element data-confetti>       → small brand-colored burst from the
 *    element on click. Meant for CTAs that DON'T navigate away (e.g. WhatsApp
 *    links opening a new tab). On navigating CTAs the page unloads before the
 *    first frame — don't bother.
 *  - <element data-confetti-burst> → one celebratory volley when the page
 *    loads (completion moments: /thank-you after the contact form submits).
 *
 * The library is imported dynamically on first use — zero JS cost until a
 * click / a burst page. `disableForReducedMotion` is always on, per the
 * site's motion rules.
 */
---

<script>
  import type confetti from "canvas-confetti";

  const BRAND = ["#f48200", "#fbbf24", "#ffffff", "#94a3b8"];

  let lib: typeof confetti | null = null;
  const load = async () => {
    if (!lib) lib = (await import("canvas-confetti")).default;
    return lib;
  };

  const clickBurst = async (el: HTMLElement) => {
    const c = await load();
    const r = el.getBoundingClientRect();
    c({
      particleCount: 60,
      spread: 70,
      startVelocity: 28,
      scalar: 0.9,
      ticks: 120,
      colors: BRAND,
      origin: {
        x: (r.left + r.width / 2) / window.innerWidth,
        y: (r.top + r.height / 2) / window.innerHeight,
      },
      disableForReducedMotion: true,
    });
  };

  const pageBurst = async () => {
    const c = await load();
    const opts = {
      colors: BRAND,
      ticks: 200,
      disableForReducedMotion: true,
    };
    // Two side cannons + a center pop, staggered like a real celebration.
    c({ ...opts, particleCount: 90, spread: 60, angle: 60, origin: { x: 0, y: 0.7 } });
    c({ ...opts, particleCount: 90, spread: 60, angle: 120, origin: { x: 1, y: 0.7 } });
    setTimeout(() => {
      c?.({ ...opts, particleCount: 120, spread: 100, startVelocity: 35, origin: { x: 0.5, y: 0.4 } });
    }, 250);
  };

  const init = () => {
    const doc = document.documentElement;
    if (!doc.hasAttribute("data-confetti-init")) {
      doc.setAttribute("data-confetti-init", "");
      document.addEventListener("click", (e) => {
        const el = (e.target as HTMLElement | null)?.closest<HTMLElement>("[data-confetti]");
        if (el) clickBurst(el);
      });
    }
    if (document.querySelector("[data-confetti-burst]")) pageBurst();
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
