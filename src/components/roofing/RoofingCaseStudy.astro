---
/**
 * Compact proof block. One named client, no screenshot, no performance or
 * business metrics: the figures are scope counts from the client's sitemap
 * and the outcomes are stated in the client's own qualitative terms.
 */
interface Fact { value: string; label: string; }
interface Props {
  eyebrow: string;
  heading: string;
  client: string;
  location: string;
  siteUrl: string;
  summary: string;
  work: string[];
  facts: Fact[];
  factsNote: string;
  outcomes: string[];
  quote: string;
  quoteAttribution: string;
}
const { eyebrow, heading, client, location, siteUrl, summary, work, facts, factsNote, outcomes, quote, quoteAttribution } = Astro.props;
---

<section id="proof" class="relative bg-[#101518] py-20 font-poppins text-white sm:py-24">
  <div class="absolute inset-x-0 top-0 h-10 bg-white" style="clip-path: polygon(0 0, 100% 0, 100% 100%, 0 0);" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <p class="mb-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.22em] text-orange-400">
          <span class="h-px w-6 bg-orange-400"></span>{eyebrow}
        </p>
        <h2 class="text-display-2 text-white" style="text-wrap: balance;">{heading}</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">{summary}</p>
        <p class="mt-4 text-sm text-slate-400">
          <span class="font-semibold text-white">{client}</span> · {location} ·
          <a href={siteUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-orange-400 hover:text-orange-300">live site</a>
        </p>
        <dl class="mt-8 grid grid-cols-3 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10">
          {facts.map((f) => (
            <div class="bg-[#151b1f] px-4 py-4">
              <dd class="text-2xl font-extrabold text-white" style="font-variant-numeric: tabular-nums;">{f.value}</dd>
              <dt class="mt-0.5 text-[11px] uppercase tracking-wider text-slate-400">{f.label}</dt>
            </div>
          ))}
        </dl>
        <p class="mt-3 text-xs text-slate-500">{factsNote}</p>
      </div>

      <div class="lg:col-span-7">
        <div class="grid gap-8 sm:grid-cols-2">
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider text-orange-400">What we did</h3>
            <ul class="mt-3 space-y-2.5">
              {work.map((w) => (
                <li class="flex gap-2.5 text-slate-200">
                  <svg class="mt-1 h-4 w-4 flex-none text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span class="text-sm leading-relaxed">{w}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider text-orange-400">What changed for them</h3>
            <ul class="mt-3 space-y-2.5">
              {outcomes.map((o) => (
                <li class="flex gap-2.5 text-slate-200">
                  <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-orange-400"></span>
                  <span class="text-sm leading-relaxed">{o}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <blockquote class="mt-10 border-l-4 border-brand pl-6">
          <p class="text-lg font-semibold leading-snug text-white">{quote}</p>
          <footer class="mt-2 text-sm text-slate-400">{quoteAttribution}</footer>
        </blockquote>
      </div>
    </div>
  </div>
  <div class="absolute inset-x-0 bottom-0 h-10 bg-white" style="clip-path: polygon(0 100%, 100% 0, 100% 100%, 0 100%);" aria-hidden="true"></div>
</section>
