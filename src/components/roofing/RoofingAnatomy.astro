---
/**
 * "What a roofing website needs to get the call." An annotated wireframe of
 * a roofing site next to the list of parts. The numbers map the callouts on
 * the wireframe to the items in the list; that is the only reason they exist.
 */
interface Part {
  name: string;
  why: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  parts: Part[];
}

const { eyebrow, heading, intro, parts } = Astro.props;
---

<section id="anatomy" class="bg-[#fbfaf9] py-20 font-poppins sm:py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-orange-600">{eyebrow}</p>
      <h2 class="text-display-2 text-slate-900" style="text-wrap: balance;">{heading}</h2>
      <p class="mt-5 text-lg leading-relaxed text-slate-600">{intro}</p>
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-10">
      <!-- Annotated wireframe -->
      <div class="lg:col-span-6">
        <div class="lg:sticky lg:top-28">
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-900/5">
            <!-- Browser bar -->
            <div class="flex items-center gap-2 border-b border-slate-200 bg-slate-50 px-4 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
              <span class="ml-3 h-5 flex-1 rounded-md bg-slate-200/70"></span>
            </div>

            <!-- 1 Call bar -->
            <div class="relative flex items-center justify-between bg-[#101518] px-4 py-3 text-white">
              <span class="h-3 w-24 rounded bg-white/30"></span>
              <span class="rounded-md bg-brand px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider">Call now</span>
              <span class="absolute left-2 top-1/2 -translate-y-1/2 flex h-7 w-7 items-center justify-center rounded-full bg-brand text-xs font-extrabold text-white ring-4 ring-white">1</span>
            </div>

            <!-- 2 Storm hero -->
            <div class="relative border-b border-slate-100 bg-gradient-to-br from-slate-100 to-slate-50 px-5 py-7">
              <span class="block h-2 w-20 rounded bg-orange-300"></span>
              <span class="mt-3 block h-5 w-3/4 rounded bg-slate-800"></span>
              <span class="mt-2 block h-5 w-1/2 rounded bg-slate-800"></span>
              <span class="mt-4 block h-3 w-2/3 rounded bg-slate-300"></span>
              <div class="mt-5 grid grid-cols-3 gap-2">
                <span class="h-8 rounded-md border border-slate-300 bg-white"></span>
                <span class="h-8 rounded-md border border-slate-300 bg-white"></span>
                <span class="h-8 rounded-md bg-brand"></span>
              </div>
              <span class="absolute left-2 top-5 flex h-7 w-7 items-center justify-center rounded-full bg-brand text-xs font-extrabold text-white ring-4 ring-white">2</span>
              <span class="absolute right-2 bottom-5 flex h-7 w-7 items-center justify-center rounded-full bg-brand text-xs font-extrabold text-white ring-4 ring-white">8</span>
            </div>

            <!-- 3 Service areas + 7 commercial/residential -->
            <div class="relative grid grid-cols-2 gap-3 border-b border-slate-100 px-5 py-5">
              <div class="rounded-lg border border-slate-200 p-3">
                <span class="block h-2.5 w-16 rounded bg-slate-700"></span>
                <span class="mt-2 block h-2 w-full rounded bg-slate-200"></span>
                <span class="mt-1 block h-2 w-5/6 rounded bg-slate-200"></span>
              </div>
              <div class="rounded-lg border border-slate-200 p-3">
                <span class="block h-2.5 w-20 rounded bg-slate-700"></span>
                <span class="mt-2 block h-2 w-full rounded bg-slate-200"></span>
                <span class="mt-1 block h-2 w-4/6 rounded bg-slate-200"></span>
              </div>
              <div class="col-span-2 flex flex-wrap gap-1.5">
                {["Plano","Tampa","Aurora","Mesa","Marietta","Cary","+14"].map((c) => (
                  <span class="rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] font-medium text-slate-500">{c}</span>
                ))}
              </div>
              <span class="absolute left-2 top-4 flex h-7 w-7 items-center justify-center rounded-full bg-brand text-xs font-extrabold text-white ring-4 ring-white">7</span>
              <span class="absolute right-2 bottom-4 flex h-7 w-7 items-center justify-center rounded-full bg-brand text-xs font-extrabold text-white ring-4 ring-white">3</span>
            </div>

            <!-- 4 Proof wall + 5 gallery -->
            <div class="relative border-b border-slate-100 px-5 py-5">
              <div class="flex items-center gap-2">
                <span class="text-sm tracking-tight text-orange-500">★★★★★</span>
                <span class="h-2 w-24 rounded bg-slate-300"></span>
              </div>
              <div class="mt-3 grid grid-cols-4 gap-2">
                <span class="aspect-[4/3] rounded-md bg-slate-200"></span>
                <span class="aspect-[4/3] rounded-md bg-slate-300"></span>
                <span class="aspect-[4/3] rounded-md bg-slate-200"></span>
                <span class="aspect-[4/3] rounded-md bg-slate-300"></span>
              </div>
              <span class="absolute left-2 top-4 flex h-7 w-7 items-center justify-center rounded-full bg-brand text-xs font-extrabold text-white ring-4 ring-white">4</span>
              <span class="absolute right-2 bottom-4 flex h-7 w-7 items-center justify-center rounded-full bg-brand text-xs font-extrabold text-white ring-4 ring-white">5</span>
            </div>

            <!-- 6 Financing + insurance -->
            <div class="relative grid grid-cols-2 gap-3 px-5 py-5">
              <div class="rounded-lg bg-orange-50 p-3 ring-1 ring-orange-100">
                <span class="block h-2.5 w-20 rounded bg-orange-400"></span>
                <span class="mt-2 block h-2 w-full rounded bg-orange-200"></span>
              </div>
              <div class="rounded-lg bg-slate-50 p-3 ring-1 ring-slate-200">
                <span class="block h-2.5 w-24 rounded bg-slate-600"></span>
                <span class="mt-2 block h-2 w-full rounded bg-slate-200"></span>
              </div>
              <span class="absolute left-2 top-4 flex h-7 w-7 items-center justify-center rounded-full bg-brand text-xs font-extrabold text-white ring-4 ring-white">6</span>
            </div>
          </div>
          <p class="mt-3 text-center text-xs text-slate-500">The parts of a roofing website that produce calls, numbered to match the list.</p>
        </div>
      </div>

      <!-- Parts list -->
      <ol class="space-y-6 lg:col-span-6">
        {parts.map((part, i) => (
          <li class="flex gap-4">
            <span class="mt-0.5 flex h-8 w-8 flex-none items-center justify-center rounded-full bg-[#101518] text-sm font-extrabold text-white" style="font-variant-numeric: tabular-nums;">{i + 1}</span>
            <div>
              <h3 class="text-lg font-bold text-slate-900">{part.name}</h3>
              <p class="mt-1 leading-relaxed text-slate-600">{part.why}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
