---
interface Props {
  heading: string;
  body: string;
  rating: string;
  reviewCount: string;
  reviewsUrl: string;
}
const { heading, body, rating, reviewCount, reviewsUrl } = Astro.props;
---

<section class="bg-white pt-20 font-poppins sm:pt-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-8 md:grid-cols-12">
      <div class="md:col-span-8">
        <h2 class="text-display-2 text-slate-900" style="text-wrap: balance;">{heading}</h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">{body}</p>
      </div>
      <div class="md:col-span-4">
        <a href={reviewsUrl} target="_blank" rel="noopener noreferrer" class="block rounded-2xl border border-slate-200 bg-[#fbfaf9] p-6 text-center transition hover:border-orange-300">
          <p class="text-5xl font-extrabold text-slate-900" style="font-variant-numeric: tabular-nums;">{rating}</p>
          <p class="mt-1 text-lg tracking-tight text-orange-500" aria-hidden="true">★★★★★</p>
          <p class="mt-1 text-sm text-slate-600">{reviewCount} Google reviews</p>
        </a>
      </div>
    </div>
  </div>
</section>
