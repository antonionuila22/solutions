---
interface Step {
  title: string;
  body: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  exampleCities: string[];
  exampleNote: string;
  steps: Step[];
}

const { eyebrow, heading, intro, exampleCities, exampleNote, steps } = Astro.props;
---

<section id="local-seo" class="bg-[#fbfaf9] py-20 font-poppins sm:py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-orange-600">{eyebrow}</p>
        <h2 class="text-display-2 text-slate-900" style="text-wrap: balance;">{heading}</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">{intro}</p>

        <!-- The example: one page per city -->
        <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Example: one page per city</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {exampleCities.map((c) => (
              <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-sm font-medium text-slate-700">Roof repair in {c}</span>
            ))}
          </div>
          <p class="mt-3 text-xs text-slate-500">{exampleNote}</p>
        </div>
      </div>

      <ol class="space-y-5 lg:col-span-7">
        {steps.map((s) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-6">
            <h3 class="text-lg font-bold text-slate-900">{s.title}</h3>
            <p class="mt-2 leading-relaxed text-slate-600">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
