---
/**
 * Roofing industry hero. Left-aligned editorial layout on an asphalt-dark
 * ground. The visual is a phone mock of the kind of site we build, not a
 * client screenshot: the page is about the service. Everything in the proof
 * row must stay verifiable.
 */
interface ProofItem {
  value: string;
  label: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  subtitle: string;
  primaryHref: string;
  primaryText: string;
  secondaryHref: string;
  secondaryText: string;
  visualCaption: string;
  proof: ProofItem[];
}

const {
  eyebrow, heading, subtitle, primaryHref, primaryText,
  secondaryHref, secondaryText, visualCaption, proof,
} = Astro.props;
---

<section class="relative overflow-hidden bg-[#101518] text-white font-poppins">
  <!-- Shingle pattern: staggered courses, very low contrast -->
  <svg class="absolute inset-0 h-full w-full opacity-[0.06]" aria-hidden="true">
    <defs>
      <pattern id="roof-shingles" width="96" height="48" patternUnits="userSpaceOnUse">
        <rect x="0" y="0" width="94" height="22" fill="none" stroke="#f4f1ea" stroke-width="1"></rect>
        <rect x="48" y="24" width="94" height="22" fill="none" stroke="#f4f1ea" stroke-width="1"></rect>
        <rect x="-48" y="24" width="94" height="22" fill="none" stroke="#f4f1ea" stroke-width="1"></rect>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#roof-shingles)"></rect>
  </svg>
  <div class="absolute -top-40 -left-40 h-[36rem] w-[36rem] rounded-full bg-orange-500/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 pb-20 pt-28 sm:px-6 sm:pt-32 lg:px-8 lg:pb-28 lg:pt-36">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
      <!-- Copy -->
      <div class="lg:col-span-7">
        <p class="mb-5 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.22em] text-orange-400">
          <span class="h-px w-6 bg-orange-400"></span>
          {eyebrow}
        </p>
        <h1 class="text-hero text-white" style="text-wrap: balance;">{heading}</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300 sm:text-xl">{subtitle}</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href={primaryHref}
            class="group inline-flex items-center justify-center gap-3 rounded-xl bg-brand px-7 py-4 text-base font-bold text-white shadow-lg shadow-orange-500/25 transition hover:bg-brand-strong hover:shadow-orange-500/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-400"
          >
            {primaryText}
            <svg class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a
            href={secondaryHref}
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/5 px-7 py-4 text-base font-semibold text-white transition hover:border-white/30 hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-400"
          >
            {secondaryText}
          </a>
        </div>
      </div>

      <!-- Phone mock of the kind of site we build -->
      <div class="lg:col-span-5">
        <figure class="mx-auto max-w-[320px]">
          <div class="relative rounded-[2.2rem] border border-white/15 bg-[#0b0f11] p-2.5 shadow-2xl shadow-black/60" aria-hidden="true">
            <div class="overflow-hidden rounded-[1.7rem] bg-white text-slate-900">
              <!-- status + call bar -->
              <div class="flex items-center justify-between bg-[#101518] px-4 pt-3 pb-2 text-white">
                <span class="text-[10px] font-semibold tracking-wide text-slate-400">9:41</span>
                <span class="flex gap-1"><span class="h-1.5 w-1.5 rounded-full bg-slate-500"></span><span class="h-1.5 w-1.5 rounded-full bg-slate-500"></span><span class="h-1.5 w-1.5 rounded-full bg-slate-500"></span></span>
              </div>
              <div class="flex items-center justify-between bg-[#101518] px-4 pb-3 text-white">
                <span class="flex items-center gap-2"><span class="h-5 w-5 rounded-md bg-brand"></span><span class="text-xs font-bold">Your Roofing Co.</span></span>
                <span class="rounded-md bg-brand px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider">Call now</span>
              </div>
              <!-- storm hero -->
              <div class="bg-gradient-to-b from-orange-50 to-white px-4 pb-4 pt-5">
                <span class="inline-block rounded-full bg-orange-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-orange-700">Storm damage?</span>
                <p class="mt-2 text-[17px] font-extrabold leading-tight tracking-tight">Free roof inspection this week</p>
                <p class="mt-1 text-[11px] text-slate-500">Licensed, insured, and in your area today.</p>
                <div class="mt-3 flex flex-wrap gap-1">
                  {["Plano","Tampa","Aurora","Mesa","+18 cities"].map((c) => (
                    <span class="rounded-full border border-slate-200 bg-white px-2 py-0.5 text-[9px] font-medium text-slate-600">{c}</span>
                  ))}
                </div>
              </div>
              <!-- 3-field form -->
              <div class="border-t border-slate-100 px-4 py-4">
                <div class="space-y-2">
                  <div class="rounded-lg border border-slate-200 px-3 py-2 text-[11px] text-slate-400">Street address</div>
                  <div class="rounded-lg border border-slate-200 px-3 py-2 text-[11px] text-slate-400">What is wrong with the roof?</div>
                  <div class="rounded-lg border border-slate-200 px-3 py-2 text-[11px] text-slate-400">Phone number</div>
                </div>
                <div class="mt-3 rounded-lg bg-brand py-2.5 text-center text-[12px] font-bold text-white">Request my inspection</div>
                <p class="mt-2 text-center text-[9px] text-slate-400">We text you back within minutes</p>
              </div>
              <!-- proof strip -->
              <div class="flex items-center justify-between border-t border-slate-100 bg-slate-50 px-4 py-3">
                <span class="text-[11px] tracking-tight text-orange-500">★★★★★</span>
                <span class="text-[9px] font-semibold uppercase tracking-wider text-slate-500">Reviews with names</span>
                <span class="rounded bg-white px-1.5 py-0.5 text-[9px] font-semibold text-slate-600 ring-1 ring-slate-200">Financing</span>
              </div>
            </div>
          </div>
          <figcaption class="mt-4 text-center text-sm text-slate-400">{visualCaption}</figcaption>
        </figure>
      </div>
    </div>

    <!-- Proof row -->
    <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 md:grid-cols-4">
      {proof.map((item) => (
        <div class="bg-[#101518] px-5 py-5">
          <dd class="text-2xl font-extrabold text-white sm:text-3xl" style="font-variant-numeric: tabular-nums;">{item.value}</dd>
          <dt class="mt-0.5 text-xs uppercase tracking-wider text-slate-400">{item.label}</dt>
        </div>
      ))}
    </dl>
  </div>

  <div class="h-10 bg-[#fbfaf9]" style="clip-path: polygon(0 100%, 100% 0, 100% 100%, 0 100%);" aria-hidden="true"></div>
</section>
