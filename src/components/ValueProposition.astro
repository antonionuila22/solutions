---
interface ValuePropConfig {
  flagLeft: string;
  flagRight: string;
  flagLabel: string;
  title: string;
  titleHighlight: string;
  subtitle: string;
  stats: { value: string; title: string; description: string }[];
  benefitsTitle: string;
  benefits: { title: string; description: string }[];
  budget: {
    title: string;
    subtitle: string;
    steps: { title: string; description: string }[];
    ctaText: string;
    ctaHref: string;
  };
  ctaText: string;
  ctaSubtext: string;
}

interface Props {
  config?: Partial<ValuePropConfig>;
}

const defaults: ValuePropConfig = {
  flagLeft: "\u{1F1ED}\u{1F1F3}",
  flagRight: "\u{1F1FA}\u{1F1F8}",
  flagLabel: "Honduras → United States",
  title: "Premium Web Development",
  titleHighlight: "at 60% Lower Cost",
  subtitle: 'Why pay US agency overhead for <a href="/services/web-development/" class="text-cyan-500 hover:text-cyan-600 font-semibold">web development</a> when you can get the same professional quality from our certified team in Honduras, scoped to the budget you already have?',
  stats: [
    { value: "60%", title: "Cost Savings", description: "Save thousands compared to US agency rates while maintaining the same professional quality standards." },
    { value: "100%", title: "Same Quality", description: "Our certified professionals deliver the exact same quality as US agencies. Same standards, better prices." },
    { value: "CST", title: "US Time Zone", description: "Work seamlessly with our bilingual team. Honduras operates in Central Time (CST) for real-time collaboration." },
  ],
  benefitsTitle: "Why US Companies Choose Codebrand",
  benefits: [
    { title: "Certified Professional Team", description: "Our developers hold certifications from Udemy, Platzi, and Adobe, ensuring cutting-edge expertise in modern technologies." },
    { title: "Export-Quality Services", description: "We specialize in serving international clients with the same standards expected by Fortune 500 companies." },
    { title: "Managed Honduran Talent", description: "We handle all talent management, so you get premium results without the overhead costs." },
    { title: "Bilingual Communication", description: "Fluent English-speaking team ensures clear communication throughout your project lifecycle." },
    { title: "Proven Track Record", description: "50+ successful projects delivered to international clients across various industries." },
  ],
  budget: {
    title: "Priced from your budget",
    subtitle: "No price list. A fixed price for the scope that fits.",
    steps: [
      { title: "You set the budget", description: "Tell us what you need and the budget you have in mind, total or per month." },
      { title: "We size the resources", description: "A website, a store, an application, or developers with your stack: roles, seniority and timeline that fit the number." },
      { title: "You approve a fixed price", description: "One price for the agreed scope, no hourly surprises, and you own 100% of the code." },
    ],
    ctaText: "Request a proposal",
    ctaHref: "/quoter/",
  },
  ctaText: "Get Your Free Quote Today",
  ctaSubtext: "Join 50+ US businesses saving thousands on quality web development",
};

const c = { ...defaults, ...Astro.props.config };
---

<section
  class="py-16 sm:py-20 lg:py-28 bg-white font-poppins overflow-hidden"
  id="value-proposition"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-10 sm:mb-12 lg:mb-16 value-header">
      <div
        class="inline-flex items-center gap-3 px-5 py-2.5 bg-slate-100 rounded-full mb-6"
      >
        <span class="text-2xl">{c.flagLeft}</span>
        <span
          class="text-sm font-semibold text-slate-700 uppercase tracking-wide"
        >
          {c.flagLabel}
        </span>
        <span class="text-2xl">{c.flagRight}</span>
      </div>
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-slate-900 mb-4 sm:mb-6 leading-tight px-2 sm:px-0"
        data-anim="heading"
      >
        {c.title}<br />
        <span class="text-cyan-600">{c.titleHighlight}</span>
      </h2>
      <p
        class="text-base sm:text-lg lg:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed px-2 sm:px-0"
        data-anim="fade"
        data-delay="0.15"
      >
        <Fragment set:html={c.subtitle} />
      </p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 md:gap-8 mb-12 sm:mb-16 lg:mb-20 stats-grid">
      {c.stats.map((stat, i) => (
        <div class="stat-card group" data-anim="fade" data-anim-group="vp-stats" data-stagger="0.14" data-fade-offset="50">
          <div
            class="bg-gradient-to-br from-slate-50 to-white border border-slate-200 rounded-2xl p-5 sm:p-6 lg:p-8 hover:shadow-xl transition-all duration-300 h-full"
          >
            <div
              class={`flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 lg:w-16 lg:h-16 ${i === 1 ? "bg-orange-500" : "bg-cyan-900"} rounded-xl mb-4 sm:mb-5 lg:mb-6 group-hover:scale-110 transition-transform duration-300`}
            >
              <svg class="w-6 h-6 sm:w-7 sm:h-7 lg:w-8 lg:h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="text-4xl sm:text-5xl font-bold text-slate-900 mb-2 sm:mb-3">{stat.value}</div>
            <h3 class="text-lg sm:text-xl font-semibold text-slate-900 mb-1 sm:mb-2">{stat.title}</h3>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">{stat.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Main Content Grid -->
    <div
      class="grid grid-cols-1 lg:grid-cols-5 gap-6 sm:gap-8 lg:gap-12 items-start content-grid"
    >
      <!-- Why Choose Us -->
      <div class="lg:col-span-3 space-y-6">
        <h3 class="text-3xl font-semibold text-slate-900 mb-8">
          {c.benefitsTitle}
        </h3>

        <div class="space-y-4 benefits-list">
          {c.benefits.map((benefit) => (
            <div class="benefit-item flex items-start gap-4 p-5 bg-slate-50 rounded-xl hover:bg-slate-100 transition-colors duration-300">
              <div class="flex-shrink-0 w-10 h-10 bg-cyan-900 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-slate-900 mb-1">{benefit.title}</h4>
                <p class="text-slate-600 text-sm leading-relaxed">{benefit.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Budget model (replaces the old price comparison card) -->
      <div class="lg:col-span-2 price-comparison">
        <div class="sticky top-8">
          <div
            class="bg-gradient-to-br from-slate-50 to-white border-2 border-slate-200 rounded-2xl p-5 sm:p-6 lg:p-8 shadow-lg"
          >
            <div class="text-center mb-8">
              <h3 class="text-2xl font-semibold text-slate-900 mb-2">
                {c.budget.title}
              </h3>
              <p class="text-sm text-slate-600">
                {c.budget.subtitle}
              </p>
            </div>

            <ol class="space-y-4">
              {c.budget.steps.map((step, i) => (
                <li class="flex items-start gap-4 bg-white rounded-xl p-5 border-2 border-slate-200 shadow-sm">
                  <span class="flex-shrink-0 w-9 h-9 rounded-full bg-cyan-900 text-white text-sm font-bold flex items-center justify-center tabular-nums">
                    {i + 1}
                  </span>
                  <div>
                    <p class="font-semibold text-slate-900">{step.title}</p>
                    <p class="text-sm text-slate-600 leading-relaxed mt-1">{step.description}</p>
                  </div>
                </li>
              ))}
            </ol>

            <a
              href={c.budget.ctaHref}
              class="mt-6 flex items-center justify-center gap-2 w-full py-3.5 rounded-xl bg-cyan-900 hover:bg-cyan-800 text-white font-semibold transition-colors duration-300"
            >
              {c.budget.ctaText}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-16 cta-section">
      <a
        href="/contact/"
        class="inline-flex items-center justify-center gap-3 px-8 py-3.5 bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white rounded-2xl font-bold text-lg shadow-lg shadow-orange-500/25 hover:shadow-orange-500/40 transform hover:-translate-y-1 transition-all duration-300"
      >
        {c.ctaText}
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
      <p class="text-slate-500 mt-5 text-sm">
        {c.ctaSubtext}
      </p>
    </div>
  </div>
</section>

<style>
  /* The reveal-on-scroll HIDDEN starting state is gated behind `.js-anim`
     (added by the script below only once it runs). If JS never runs, or the
     IntersectionObserver misfires, there is no `.js-anim`, so the content stays
     VISIBLE by default — this section must never sit blank (it was rendering as
     an empty white block on /hn). Animation is a pure enhancement. */
  #value-proposition.js-anim .value-header,
  #value-proposition.js-anim .stat-card,
  #value-proposition.js-anim .benefit-item,
  #value-proposition.js-anim .price-comparison,
  #value-proposition.js-anim .cta-section {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  #value-proposition.js-anim .benefit-item { transform: translateX(-30px); }
  #value-proposition.js-anim .price-comparison { transform: translateX(50px); }
  .animate-visible {
    opacity: 1 !important;
    transform: translateY(0) translateX(0) !important;
  }
</style>

<script>
  function initValuePropositionAnimations() {
    const section = document.getElementById('value-proposition');
    if (!section) return;
    const elements = section.querySelectorAll<HTMLElement>(
      '.value-header, .stat-card, .benefit-item, .price-comparison, .cta-section'
    );
    if (!elements.length) return;

    // Only now (JS is running) do we opt into the hidden-then-animate state.
    section.classList.add('js-anim');

    const reveal = (el: Element) => el.classList.add('animate-visible');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.matchMedia('(min-width: 768px)').matches;

    if (reducedMotion || !isDesktop || !('IntersectionObserver' in window)) {
      elements.forEach(reveal);
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          reveal(entry.target);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    elements.forEach((el, i) => {
      el.style.transitionDelay = `${i * 0.08}s`;
      observer.observe(el);
    });

    // Safety net: if the observer never fires for some element (tab restored
    // in the background, layout race, etc.), force everything visible after a
    // short delay so the section can never stay blank.
    window.setTimeout(() => elements.forEach(reveal), 1500);
  }

  initValuePropositionAnimations();
  document.addEventListener('astro:page-load', initValuePropositionAnimations);
</script>
