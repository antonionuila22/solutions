---
/**
 * RelatedPosts — server-computed related articles for the blog post template.
 * Scoring: shared categories (1pt) + shared tags (0.5pt); newer posts win
 * ties; padded with the most recent posts when there are not enough matches.
 * Renders the shared editorial PostCard (blog shell redesign).
 */
import type { CollectionEntry } from "astro:content";
import PostCard from "./blog/PostCard.astro";

interface Props {
  currentId: string;
  posts: CollectionEntry<"blog">[];
  categories?: string[];
  tags?: string[];
  limit?: number;
}

const { currentId, posts, categories = [], tags = [], limit = 3 } = Astro.props;

const currentCategories = new Set(categories);
const currentTags = new Set(tags);

// Score posts by shared categories (1pt) + shared tags (0.5pt). Newer posts win ties.
const scored = posts
  .filter((p) => p.id !== currentId && !p.data.draft)
  .map((p) => {
    let score = 0;
    for (const c of p.data.categories || []) {
      if (currentCategories.has(c)) score += 1;
    }
    for (const t of p.data.tags || []) {
      if (currentTags.has(t)) score += 0.5;
    }
    const ts = p.data.date ? new Date(p.data.date).getTime() : 0;
    return { post: p, score, ts };
  })
  .sort((a, b) => b.score - a.score || b.ts - a.ts);

// Take top scored matches; if fewer than limit, pad with most recent unrelated posts.
const topRelated = scored.slice(0, limit).map((s) => s.post);
const related = topRelated.length === limit
  ? topRelated
  : [
      ...topRelated,
      ...scored
        .slice(limit)
        .sort((a, b) => b.ts - a.ts)
        .slice(0, limit - topRelated.length)
        .map((s) => s.post),
    ];
---

{
  related.length > 0 && (
    <section class="border-t border-slate-200 bg-slate-50 py-16 sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">
          Keep reading
        </p>
        <h2 class="text-display-2 mt-4 text-slate-900">Related Articles</h2>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </div>
    </section>
  )
}
