---
import Testimonial from "./Testimonial.astro";
import SpriteIcon from "./icons/SpriteIcon.astro";
---

<section class="py-16 sm:py-20 lg:py-28 bg-slate-950 font-poppins">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-yellow-500/10 border border-yellow-500/20 rounded-full mb-6">
        <SpriteIcon name="star" class="w-4 h-4 text-yellow-400" />
        <span class="text-sm font-medium text-yellow-400">Google Reviews</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
        What Our <span class="text-orange-500">Clients Say</span>
      </h2>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto">Real reviews from our satisfied clients</p>
    </div>
  </div>
  <Testimonial />
</section>
