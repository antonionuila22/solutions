---
interface Platform { name: string; tagline: string; pros: string[]; cons: string[]; pick: string; }
interface Props { eyebrow: string; heading: string; intro: string; platforms: Platform[]; }
const { eyebrow, heading, intro, platforms } = Astro.props;
---

<section id="platforms" class="bg-white py-20 font-poppins sm:py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-cyan-700">{eyebrow}</p>
      <h2 class="text-display-2 text-slate-900" style="text-wrap: balance;">{heading}</h2>
      <p class="mt-5 text-lg leading-relaxed text-slate-600">{intro}</p>
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {platforms.map((p) => (
        <article class="flex flex-col rounded-2xl border border-slate-200 bg-[#fbfaf9] p-6">
          <h3 class="text-xl font-extrabold text-slate-900">{p.name}</h3>
          <p class="mt-1 text-sm text-slate-600">{p.tagline}</p>
          <ul class="mt-5 space-y-1.5 text-sm">
            {p.pros.map((x) => (
              <li class="flex gap-2 text-slate-700"><span class="font-bold text-emerald-600" aria-hidden="true">+</span><span>{x}</span></li>
            ))}
            {p.cons.map((x) => (
              <li class="flex gap-2 text-slate-700"><span class="font-bold text-rose-600" aria-hidden="true">−</span><span>{x}</span></li>
            ))}
          </ul>
          <p class="mt-5 border-t border-dotted border-slate-300 pt-4 text-sm text-slate-700"><span class="font-semibold text-slate-900">Pick it if: </span>{p.pick}</p>
        </article>
      ))}
    </div>

    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
