---
import { BUSINESS_INFO } from "../../configs/business";
interface Props { heading: string; body: string; checks: string[]; primaryHref: string; primaryText: string; }
const { heading, body, checks, primaryHref, primaryText } = Astro.props;
const { phone, phoneRaw, whatsappUrl } = BUSINESS_INFO.us;
---

<section id="cta" class="relative bg-[#0b1f2a] py-20 font-poppins text-white sm:py-24">
  <div class="absolute inset-x-0 top-0 h-4 bg-[#fbfaf9]" style="background-image: linear-gradient(-45deg, #0b1f2a 8px, transparent 0), linear-gradient(45deg, #0b1f2a 8px, transparent 0); background-size: 16px 16px; transform: scaleY(-1);" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6">
        <h2 class="text-display-2 text-white" style="text-wrap: balance;">{heading}</h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-300">{body}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={primaryHref} class="inline-flex items-center justify-center gap-3 rounded-xl bg-brand px-7 py-4 text-base font-bold text-white shadow-lg shadow-orange-500/20 transition hover:bg-brand-strong">
            {primaryText}
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a href={`tel:${phoneRaw}`} class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 px-5 py-4 text-sm font-semibold text-white hover:bg-white/10">Call {phone}</a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 px-5 py-4 text-sm font-semibold text-white hover:bg-white/10">WhatsApp</a>
        </div>
      </div>
      <!-- What the audit covers, as a receipt -->
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-8 lg:col-span-6">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-cyan-300">What the free audit covers</p>
        <ul class="mt-3">
          {checks.map((c) => (
            <li class="flex items-baseline justify-between gap-4 border-b border-dotted border-white/20 py-3 text-sm">
              <span class="text-slate-100">{c}</span>
              <span class="flex-none text-[11px] font-bold uppercase tracking-wider text-cyan-300">Free</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-slate-400">Two business days. A written page with what we found and what it would cost to fix, in that order.</p>
      </div>
    </div>
  </div>
</section>
