---
/**
 * Ecommerce hero. Centered headline on the light ground, then the working
 * demo store as the stage (passed through the slot as a React island), then a
 * receipt-style proof row. Deliberately the opposite composition of the
 * roofing page: light, centered, and interactive above the fold.
 */
interface ProofItem { value: string; label: string; }
interface Props {
  eyebrow: string;
  heading: string;
  subtitle: string;
  primaryHref: string;
  primaryText: string;
  secondaryHref: string;
  secondaryText: string;
  stageCaption: string;
  proof: ProofItem[];
}
const { eyebrow, heading, subtitle, primaryHref, primaryText, secondaryHref, secondaryText, stageCaption, proof } = Astro.props;
---

<section class="relative overflow-hidden bg-[#fbfaf9] font-poppins">
  <!-- Faint grid, like a price tag sheet -->
  <div class="absolute inset-0 opacity-[0.35]" style="background-image: radial-gradient(circle at 1px 1px, #cbd5e1 1px, transparent 0); background-size: 28px 28px;" aria-hidden="true"></div>
  <div class="absolute -top-32 left-1/2 h-[28rem] w-[60rem] -translate-x-1/2 rounded-full bg-cyan-200/30 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 pb-16 pt-28 sm:px-6 sm:pt-32 lg:px-8 lg:pt-36">
    <div class="mx-auto max-w-4xl text-center">
      <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-cyan-200 bg-white px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-cyan-800">
        <span class="h-1.5 w-1.5 rounded-full bg-cyan-600"></span>{eyebrow}
      </p>
      <h1 class="text-hero text-slate-900" style="text-wrap: balance;">{heading}</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">{subtitle}</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={primaryHref} class="group inline-flex items-center justify-center gap-3 rounded-xl bg-brand px-7 py-4 text-base font-bold text-white shadow-lg shadow-orange-500/20 transition hover:bg-brand-strong focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500">
          {primaryText}
          <svg class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href={secondaryHref} class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-7 py-4 text-base font-semibold text-slate-800 transition hover:border-cyan-600 hover:text-cyan-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600">
          {secondaryText}
        </a>
      </div>
    </div>

    <!-- The stage: the demo store -->
    <div id="demo" class="mt-14 scroll-mt-28">
      <slot />
      <p class="mt-3 text-center text-sm text-slate-500">{stageCaption}</p>
    </div>

    <!-- Receipt-style proof row -->
    <dl class="mx-auto mt-14 grid max-w-5xl grid-cols-2 divide-y divide-dotted divide-slate-300 rounded-2xl border border-slate-200 bg-white sm:grid-cols-4 sm:divide-x sm:divide-y-0">
      {proof.map((p) => (
        <div class="px-5 py-5 text-center">
          <dd class="text-2xl font-extrabold text-slate-900 sm:text-3xl" style="font-variant-numeric: tabular-nums;">{p.value}</dd>
          <dt class="mt-1 text-[11px] uppercase tracking-wider text-slate-500">{p.label}</dt>
        </div>
      ))}
    </dl>
  </div>
</section>
